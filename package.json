{
	"name": "bella-kira-fan-site",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"prepare": "husky",
		"dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
		"optimize": "npm run gallery:optimize && npm run clothes:optimize && npm run cloth-bg:optimize && npm run recommended-covers:optimize && npm run stickers:optimize && npm run cards:generate",
		"optimize:check": "npm run gallery:check && npm run clothes:check && npm run cloth-bg:check && npm run recommended-covers:check && npm run stickers:check && npm run cards:check",
		"gallery:optimize": "node scripts/generate-gallery-previews.mjs",
		"gallery:check": "node scripts/generate-gallery-previews.mjs --check",
		"clothes:optimize": "node scripts/generate-clothes.mjs",
		"clothes:check": "node scripts/generate-clothes.mjs --check",
		"cloth-bg:optimize": "node scripts/generate-cloth-backgrounds.mjs",
		"cloth-bg:check": "node scripts/generate-cloth-backgrounds.mjs --check",
		"recommended-covers:optimize": "node scripts/generate-recommended-covers.mjs",
		"recommended-covers:check": "node scripts/generate-recommended-covers.mjs --check",
		"stickers:optimize": "node scripts/generate-sticker-previews.mjs",
		"stickers:check": "node scripts/generate-sticker-previews.mjs --check",
		"font:optimize": "node scripts/generate-site-font.mjs",
		"font:check": "node scripts/generate-site-font.mjs --check && node scripts/check-font-coverage.mjs",
		"format": "prettier --write \"**/*.{astro,json,js,jsx,mjs,cjs,ts,tsx,mts,cts}\"",
		"format:check": "prettier --check \"**/*.{astro,json,js,jsx,mjs,cjs,ts,tsx,mts,cts}\"",
		"build": "npm run format && npm run optimize:check && cross-env ASTRO_TELEMETRY_DISABLED=1 astro check && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
		"preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
		"check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
		"stop": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev stop",
		"cards:generate": "node scripts/generate-gallery-cards.mjs",
		"cards:check": "node scripts/generate-gallery-cards.mjs --check"
	},
	"dependencies": {
		"@astrojs/react": "latest",
		"@types/d3": "^7.4.3",
		"astro": "latest",
		"d3": "^7.9.0",
		"gifenc": "^1.0.3",
		"gsap": "latest",
		"image-size": "^2.0.2",
		"react": "latest",
		"react-dom": "latest",
		"three": "^0.169.0"
	},
	"devDependencies": {
		"@astrojs/check": "latest",
		"@types/node": "^26.1.1",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@types/three": "^0.169.0",
		"cross-env": "^10.1.0",
		"fontkit": "^2.0.4",
		"husky": "^9.1.7",
		"prettier": "3.9.5",
		"prettier-plugin-astro": "^0.14.1",
		"sharp": "^0.35.3",
		"typescript": "latest"
	}
}
