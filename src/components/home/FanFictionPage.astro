---
import fiction from "../../content/fan-fiction.json";
const shelfRows = Array.from(
  { length: Math.ceil(fiction.works.length / 4) },
  (_, row) => fiction.works.slice(row * 4, row * 4 + 4),
);
---
<section class="page fiction-page" aria-label="同人文"><div class="page-visual fiction-visual mobile-page-scroll-surface" data-fiction-visual>
  <div class="fiction-lamp" data-fiction-lamp aria-hidden="true"></div>
  <header><p>FAN FICTION · AFTER HOURS</p><h1>贝极星书架</h1><a class="archive-link" href="https://eileenbella.notion.site/8d7ecec93c694d8a95b72ae50f34a20b" target="_blank" rel="noopener noreferrer">这几本还不够看——去《乃贝同人文存档》继续翻 <i aria-hidden="true">↗</i></a></header>
  <div class="shelf" data-fiction-shelf>{shelfRows.map((row,rowIndex)=><div class="shelf-row">{row.map((work,columnIndex)=><button class="book" data-work={rowIndex*4+columnIndex} type="button"><span class="pages"></span><span class="cover"><i>FAN-MADE STORY</i><strong>{work.title}</strong></span></button>)}</div>)}</div>
  <div class="library-notices"><strong>同人作品，请勿上升正主</strong><p>转载作品仅作非商业同人展示，版权归原作者所有；如有侵权，请联系本站删除。</p></div>
</div><dialog class="reader" data-reader><button class="close" data-close aria-label="关闭">×</button><div class="paper"><aside><b data-work-title></b><select data-chapter-select aria-label="选择章节"></select><nav data-toc></nav></aside><article data-article></article></div></dialog></section>
<script is:inline define:vars={{works:fiction.works}}>
const reader=document.querySelector('[data-reader]'),article=reader?.querySelector('[data-article]'),toc=reader?.querySelector('[data-toc]'),select=reader?.querySelector('[data-chapter-select]'),workTitle=reader?.querySelector('[data-work-title]');let activeWork;
function showChapter(index){const chapter=activeWork?.chapters[index];if(!chapter||!article)return;const source=activeWork.sourceUrl?`<a class="work-source" href="${activeWork.sourceUrl}" target="_blank" rel="noopener noreferrer">${activeWork.sourceLabel||'查看原文'} ↗</a>`:activeWork.sourceLabel?`<span class="work-source work-source-text">${activeWork.sourceLabel}</span>`:'';const video=activeWork.relatedVideoUrl?`<a class="related-video" href="${activeWork.relatedVideoUrl}" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">▶</span>${activeWork.relatedVideoLabel||'观看相关视频'}</a>`:'';const links=source||video?`<div class="work-links">${video}${source}</div>`:'';article.innerHTML=`<header><h2>${chapter.title}</h2>${links}</header>${chapter.content.map(p=>`<p>${p}</p>`).join('')}<footer><button data-prev ${index===0?'disabled':''}>上一章</button><span>${index+1} / ${activeWork.chapters.length}</span><button data-next ${index===activeWork.chapters.length-1?'disabled':''}>下一章</button></footer>`;article.scrollTop=0;select.value=String(index);toc?.querySelectorAll('button').forEach((b,i)=>b.classList.toggle('active',i===index));article.querySelector('[data-prev]')?.addEventListener('click',()=>showChapter(index-1));article.querySelector('[data-next]')?.addEventListener('click',()=>showChapter(index+1));}
document.querySelectorAll('[data-work]').forEach(book=>book.addEventListener('click',()=>{activeWork=works[Number(book.dataset.work)];if(!activeWork||!reader)return;book.classList.add('is-drawing');window.setTimeout(()=>book.classList.remove('is-drawing'),520);workTitle.textContent=activeWork.title;toc.innerHTML='';select.innerHTML='';activeWork.chapters.forEach((c,i)=>{toc.insertAdjacentHTML('beforeend',`<button data-chapter="${i}">${String(i+1).padStart(2,'0')} ${c.title}</button>`);select.insertAdjacentHTML('beforeend',`<option value="${i}">${c.title}</option>`)});toc.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>showChapter(Number(b.dataset.chapter))));window.setTimeout(()=>{reader.showModal();showChapter(0)},reducedMotionSafe()?0:180)}));
function reducedMotionSafe(){return window.matchMedia('(prefers-reduced-motion: reduce)').matches}
select?.addEventListener('change',()=>showChapter(Number(select.value)));reader?.querySelector('[data-close]')?.addEventListener('click',()=>reader.close());reader?.addEventListener('click',e=>{if(e.target===reader)reader.close()});
const fictionVisual=document.querySelector('[data-fiction-visual]'),fictionLamp=document.querySelector('[data-fiction-lamp]'),finePointer=window.matchMedia('(pointer: fine)');
if(fictionVisual&&fictionLamp&&finePointer.matches){fictionVisual.addEventListener('pointermove',(event)=>{if(event.pointerType!=='mouse'||reducedMotionSafe())return;const bounds=fictionVisual.getBoundingClientRect();const x=((event.clientX-bounds.left)/bounds.width)*100;const y=((event.clientY-bounds.top)/bounds.height)*100;fictionLamp.style.setProperty('--lamp-x',x.toFixed(2)+'%');fictionLamp.style.setProperty('--lamp-y',y.toFixed(2)+'%');});}
</script>
<style>
.fiction-visual{position:absolute;overflow-x:hidden;overflow-y:auto;padding:clamp(8rem,14vh,10rem) clamp(2rem,7vw,8rem) 3rem;background:radial-gradient(circle at 78% 14%,#b58bbc55,transparent 30%),linear-gradient(120deg,#eee4eb,#d8c7dc);color:#382a3d}.fiction-lamp{position:absolute;z-index:0;inset:0;pointer-events:none;background:radial-gradient(circle at var(--lamp-x,72%) var(--lamp-y,22%),rgba(255,214,158,.16) 0 8%,rgba(255,188,128,.08) 18%,transparent 34%);mix-blend-mode:screen;opacity:.9;transition:opacity .3s ease}.fiction-visual>header,.fiction-visual>.shelf,.fiction-visual>.library-notices{position:relative;z-index:1}.fiction-visual>header{max-width:1100px;margin:auto}.fiction-visual header p{margin:0;color:#754b80;font:700 .7rem sans-serif;letter-spacing:.26em}.fiction-visual h1{margin:.3rem 0;font-size:clamp(2.7rem,5vw,5.3rem);font-weight:500;letter-spacing:.08em}.fiction-visual header span{letter-spacing:.12em}.archive-link{display:table;margin-top:.9rem;padding:.42rem .72rem;border:1px solid #704b7040;border-radius:999px;color:#654367;background:#fff3;font:600 .72rem/1.3 sans-serif;letter-spacing:.04em;text-decoration:none;transition:color .2s,background .2s,border-color .2s,transform .2s}.archive-link i{font-style:normal}.archive-link:hover,.archive-link:focus-visible{border-color:#704b7080;color:#49304b;background:#fff8;transform:translateY(-1px)}.shelf{display:grid;gap:3rem;width:min(1100px,100%);margin:1.25rem auto 0;box-sizing:border-box}.library-notices{display:flex;align-items:baseline;gap:1rem;max-width:1100px;margin:.85rem auto 0;font-family:sans-serif;line-height:1.6;letter-spacing:.04em}.library-notices strong{flex:none;color:#654367;font-size:.72rem}.library-notices p{margin:0;color:#5e4d606e;font-size:.66rem}.book{position:relative;width:100%;height:auto;aspect-ratio:160/225;padding:0;border:0;background:none;cursor:pointer;perspective:800px;transition:transform .35s,filter .35s}.book:hover{transform:translateY(-18px) scale(1.02);filter:drop-shadow(0 18px 18px #2a152a55)}.book:hover~.book,.shelf-row:has(.book:hover) .book:not(:hover){filter:brightness(.88)}.pages{position:absolute;inset:5px 0 0 12px;border-radius:2px 9px 9px 2px;background:repeating-linear-gradient(0deg,#eee8df 0 3px,#c9beb1 4px);box-shadow:8px 8px 12px #321f3033;transition:transform .45s cubic-bezier(.2,.8,.2,1)}.cover{position:absolute;z-index:1;inset:0 8px 7px 0;display:flex;flex-direction:column;justify-content:flex-end;padding:1.5rem;text-align:left;color:#fff;background:linear-gradient(145deg,#ffffff22,transparent 35%),#523255;border-left:9px solid #372039;border-radius:3px 9px 9px 3px;box-shadow:8px 13px 22px #2f1b313f;transform-origin:left;transition:transform .5s cubic-bezier(.2,.8,.2,1),box-shadow .35s}.book:hover .cover{transform:rotateY(-16deg) translateX(-4px);box-shadow:18px 18px 28px #1a0f1f55}.book:hover .pages{transform:translateX(5px)}.book.is-drawing{transform:translateY(-28px) scale(1.04);z-index:3}.book.is-drawing .cover{transform:rotateY(-28deg) translateX(-10px) scale(1.02)}.book.is-drawing .pages{transform:translateX(10px)}.cover i{position:absolute;top:1.5rem;right:1rem;color:#d2add5;font:600 .65rem sans-serif;letter-spacing:.17em}.cover strong{font-size:1.5rem;line-height:1.3}.cover small{margin-top:.8rem;color:#dbc5dd}.number{position:absolute;right:2rem;bottom:1rem;color:#39233c66;font:normal .7rem sans-serif;letter-spacing:.24em}@media(max-width:700px){.library-notices{display:block}.library-notices p{margin-top:.25rem}.fiction-lamp{opacity:.45}}@media(prefers-reduced-motion:reduce){.fiction-lamp{display:none}.book,.book .cover,.book .pages{transition:none}.book.is-drawing,.book.is-drawing .cover,.book.is-drawing .pages{transform:none}}
.reader{width:min(980px,calc(100vw - 2rem));height:min(84vh,850px);padding:0;border:0;overflow:visible;background:transparent}.reader::backdrop{background:#160f19bd;backdrop-filter:blur(10px)}.paper{display:grid;grid-template-columns:240px 1fr;height:100%;overflow:hidden;background:#f3ecdf;box-shadow:0 25px 80px #0008;color:#40352e}.paper aside{padding:4rem 1.4rem 2rem;border-right:1px solid #9b887744;background:#e9dfd1}.paper aside b{display:block;margin-bottom:2rem;font-size:1.1rem}.paper nav{display:grid;gap:.4rem}.paper nav button{padding:.65rem;border:0;text-align:left;color:#6c5a52;background:transparent;cursor:pointer}.paper nav button.active{color:#6f3f70;background:#fff8}.paper select{display:none;width:100%}.paper article{overflow-y:auto;padding:clamp(3rem,7vw,6rem);font-family:serif;line-height:2.15;letter-spacing:.07em}.paper article header{display:flex;flex-direction:column;align-items:center;margin:0 0 2.5rem;text-align:center}.paper article h2{margin:0;font-size:2rem;font-weight:500;line-height:1.35}.paper article header .work-links{display:flex;flex-direction:column;align-items:center;gap:.42rem;margin-top:.85rem;font:normal .64rem/1.4 sans-serif;letter-spacing:.03em}.paper article header .work-source{color:#76657880;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.22em}.paper article header .work-source:hover{color:#704b70}.paper article header .related-video{display:inline-flex!important;align-items:center;gap:.42rem;padding:.42rem .82rem!important;border:1px solid #805b7c55!important;border-radius:999px!important;color:#62405f!important;background:#8e628517!important;text-decoration:none!important;box-shadow:0 3px 10px #55304e10!important;line-height:1.2!important}.paper article header .related-video:hover{border-color:#76507388!important;color:#4f304d!important;background:#8e628524!important}.paper article header .related-video span{font-size:.5rem;color:#8b6388}.paper article>p{margin:1.15em 0;text-indent:2em;font-size:1.05rem}.paper article footer{display:flex;justify-content:space-between;align-items:center;margin-top:4rem;padding-top:1.5rem;border-top:1px solid #8e7a6944}.paper article footer button{border:0;color:#704b70;background:transparent;cursor:pointer}.paper article footer button:disabled{opacity:.3}.close{position:absolute;z-index:3;right:-1rem;top:-1rem;width:46px;height:46px;border:1px solid #fff8;border-radius:50%;color:#fff;background:#503752;font-size:2rem;cursor:pointer}.close:hover{transform:rotate(90deg)}@media(max-width:700px){.paper{display:block}.paper aside{padding:3.5rem 2rem 1rem;border:0}.paper nav{display:none}.paper select{display:block}.paper article{height:calc(100% - 130px);padding:2rem}.paper article header{margin-bottom:2rem}.close{right:.2rem;top:.2rem}}
</style>
<style is:global>
.fiction-page .fiction-visual{color:#f7eef9;background:radial-gradient(circle at 78% 14%,#7d4d8952,transparent 31%),radial-gradient(circle at 8% 90%,#db7d7424,transparent 28%),linear-gradient(132deg,#191121,#120c1c 54%,#0a0913)}
.fiction-page .fiction-lamp{background:radial-gradient(circle at var(--lamp-x,72%) var(--lamp-y,22%),rgba(255,214,158,.2) 0 7%,rgba(219,125,116,.1) 16%,transparent 34%)}
.fiction-page .fiction-visual header p{color:#d2a8dc}.fiction-page .fiction-visual h1{color:#fff8ff}.fiction-page .archive-link{border-color:#dfc6e54a;color:#eaddec;background:#ffffff0a}.fiction-page .archive-link:hover,.fiction-page .archive-link:focus-visible{border-color:#db7d7499;color:#fff;background:#db7d741a}.fiction-page .library-notices strong{color:#ebddec}.fiction-page .library-notices p{color:#d9c8dd80}.fiction-page .cover{background:linear-gradient(145deg,#ffffff1f,transparent 35%),#4b2d50;border-left-color:#2d1a33;box-shadow:8px 13px 26px #0006}.fiction-page .number{color:#d8c0dc66}
.fiction-page .book:hover~.book,.fiction-page .shelf-row:has(.book:hover) .book:not(:hover){filter:brightness(.78) saturate(.9)}
</style>
<style is:global>
.fiction-page .shelf-row{--shelf-thickness:20px;position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:end;gap:3rem;padding:1rem 3rem calc(3rem + var(--shelf-thickness));filter:drop-shadow(0 15px 12px #3b241f42)}
.fiction-page .shelf-row::before{position:absolute;z-index:2;right:0;bottom:5px;left:0;height:var(--shelf-thickness);border:1px solid #70462f;border-radius:2px 2px 3px 3px;background:radial-gradient(ellipse 34px 8px at 17% 46%,#3c21182b 0 8%,#d3a16c17 11% 18%,#4a281b22 21% 25%,transparent 29%),radial-gradient(ellipse 46px 9px at 72% 63%,#44271d24 0 7%,#e1b27a12 10% 17%,#4a2a1f20 20% 23%,transparent 27%),repeating-linear-gradient(2deg,#3f241315 0 1px,transparent 1px 4px,#e9bd8310 5px 6px,transparent 7px 11px),linear-gradient(91deg,#805035 0%,#aa7149 12%,#8d5738 27%,#b1784c 43%,#875135 61%,#a86d46 78%,#75462f 100%);background-blend-mode:multiply,soft-light,multiply,normal;box-shadow:inset 0 1px #e0ae7680,inset 0 -2px #3f271fa3,0 4px 0 #4b3026,0 8px 13px #41271f3d;content:""}
.fiction-page .shelf-row::after{position:absolute;z-index:3;right:5px;bottom:8px;left:5px;height:calc(var(--shelf-thickness) - 5px);border-radius:2px;background:repeating-linear-gradient(1deg,transparent 0 3px,#f2cc9612 4px,#3f24131a 5px,transparent 7px 10px);content:"";opacity:.7;mix-blend-mode:soft-light}
.fiction-page .reader .work-links{display:flex;flex-direction:column;align-items:center;gap:.42rem;margin-top:.85rem;font:normal .64rem/1.4 sans-serif;letter-spacing:.03em}
.fiction-page .reader .work-source{color:#76657880;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.22em}
.fiction-page .reader .work-source:hover{color:#704b70}
.fiction-page .reader .work-source-text{cursor:default;text-decoration:none}
.fiction-page .reader .work-source-text:hover{color:#76657880}
.fiction-page .reader .related-video{display:inline-flex;align-items:center;gap:.42rem;padding:.42rem .82rem;border:1px solid #805b7c55;border-radius:999px;color:#62405f;background:#8e628517;text-decoration:none;box-shadow:0 3px 10px #55304e10;line-height:1.2}
.fiction-page .reader .related-video:hover{border-color:#76507388;color:#4f304d;background:#8e628524}
.fiction-page .reader .related-video span{font-size:.5rem;color:#8b6388}
@media(max-width:700px){
  .fiction-page .fiction-visual{overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;padding:92px 18px calc(30px + env(safe-area-inset-bottom,0px))}
  .fiction-page .fiction-visual h1{font-size:2.65rem}.fiction-page .fiction-visual header span{font-size:.78rem;line-height:1.6}.fiction-page .archive-link{margin-top:12px;font-size:.68rem}
  .fiction-page .shelf{gap:18px;margin-top:22px}.fiction-page .shelf-row{--shelf-thickness:12px;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;padding:12px 4px calc(24px + var(--shelf-thickness))}.fiction-page .shelf-row::before{bottom:4px;box-shadow:inset 0 1px #e0ae7680,inset 0 -1px #3f271fa3,0 3px 0 #4b3026,0 6px 10px #41271f38}.fiction-page .shelf-row::after{right:3px;bottom:6px;left:3px;height:calc(var(--shelf-thickness) - 4px)}.fiction-page .book{width:100%;height:auto}.fiction-page .pages{inset:3px 0 0 5px}.fiction-page .cover{inset:0 3px 3px 0;padding:7px;border-left-width:4px;border-radius:2px 5px 5px 2px}.fiction-page .shelf .book .cover i{display:none}.fiction-page .shelf .book .cover strong{font-size:clamp(.58rem,2.8vw,.8rem)!important;line-height:1.25!important;overflow-wrap:anywhere}
  .fiction-page .library-notices{margin-top:18px}.fiction-page .number{display:none}
  .fiction-page .reader{width:100vw;height:100dvh;max-height:none;margin:0;overflow:hidden}.fiction-page .paper aside{height:132px;padding:calc(52px + env(safe-area-inset-top,0px)) 18px 12px}.fiction-page .paper aside b{margin-bottom:8px;font-size:.95rem}.fiction-page .paper select{min-height:40px;padding:0 9px;border:1px solid #8d786755;border-radius:4px;background:#f8f1e7;color:#54453f}.fiction-page .paper article{height:calc(100% - 132px);padding:25px 20px calc(34px + env(safe-area-inset-bottom,0px));font-size:1rem}.fiction-page .paper article h2{font-size:1.55rem}.fiction-page .paper article>p{font-size:1rem;line-height:2}.fiction-page .close{position:fixed;top:max(8px,env(safe-area-inset-top,0px));right:9px;width:40px;height:40px;font-size:1.6rem}
}
</style>
