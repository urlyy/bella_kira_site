---
import fiction from "../../content/fan-fiction.json";
---
<section class="page fiction-page" aria-label="同人文"><div class="page-visual fiction-visual mobile-page-scroll-surface">
  <header><p>FAN FICTION · LIBRARY</p><h1>贝极星书架</h1><span>把想象写成纸页，把喜欢留在故事里。</span><a class="archive-link" href="https://eileenbella.notion.site/8d7ecec93c694d8a95b72ae50f34a20b" target="_blank" rel="noopener noreferrer">故事还没有读完——去《乃贝同人文存档》继续翻页 <i aria-hidden="true">↗</i></a></header>
  <div class="shelf">{fiction.works.map((work,i)=><button class="book" data-work={i} type="button"><span class="pages"></span><span class="cover"><i>FAN FICTION</i><strong>{work.title}</strong></span></button>)}</div>
  <div class="library-notices"><strong>同人作品，请勿上升正主</strong><p>转载作品仅作非商业同人展示，版权归原作者所有；如有侵权，请联系本站删除。</p></div>
  <i class="number">08 / FICTION</i>
</div><dialog class="reader" data-reader><button class="close" data-close aria-label="关闭">×</button><div class="paper"><aside><b data-work-title></b><select data-chapter-select aria-label="选择章节"></select><nav data-toc></nav></aside><article data-article></article></div></dialog></section>
<script is:inline define:vars={{works:fiction.works}}>
const reader=document.querySelector('[data-reader]'),article=reader?.querySelector('[data-article]'),toc=reader?.querySelector('[data-toc]'),select=reader?.querySelector('[data-chapter-select]'),workTitle=reader?.querySelector('[data-work-title]');let activeWork;
function showChapter(index){const chapter=activeWork?.chapters[index];if(!chapter||!article)return;const source=activeWork.sourceUrl?`<a class="work-source" href="${activeWork.sourceUrl}" target="_blank" rel="noopener noreferrer">${activeWork.sourceLabel||'查看原文'} ↗</a>`:activeWork.sourceLabel?`<span class="work-source work-source-text">${activeWork.sourceLabel}</span>`:'';const video=activeWork.relatedVideoUrl?`<a class="related-video" href="${activeWork.relatedVideoUrl}" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">▶</span>${activeWork.relatedVideoLabel||'观看相关视频'}</a>`:'';const links=source||video?`<div class="work-links">${video}${source}</div>`:'';article.innerHTML=`<header><h2>${chapter.title}</h2>${links}</header>${chapter.content.map(p=>`<p>${p}</p>`).join('')}<footer><button data-prev ${index===0?'disabled':''}>上一章</button><span>${index+1} / ${activeWork.chapters.length}</span><button data-next ${index===activeWork.chapters.length-1?'disabled':''}>下一章</button></footer>`;article.scrollTop=0;select.value=String(index);toc?.querySelectorAll('button').forEach((b,i)=>b.classList.toggle('active',i===index));article.querySelector('[data-prev]')?.addEventListener('click',()=>showChapter(index-1));article.querySelector('[data-next]')?.addEventListener('click',()=>showChapter(index+1));}
document.querySelectorAll('[data-work]').forEach(book=>book.addEventListener('click',()=>{activeWork=works[Number(book.dataset.work)];if(!activeWork||!reader)return;workTitle.textContent=activeWork.title;toc.innerHTML='';select.innerHTML='';activeWork.chapters.forEach((c,i)=>{toc.insertAdjacentHTML('beforeend',`<button data-chapter="${i}">${String(i+1).padStart(2,'0')} ${c.title}</button>`);select.insertAdjacentHTML('beforeend',`<option value="${i}">${c.title}</option>`)});toc.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>showChapter(Number(b.dataset.chapter))));reader.showModal();showChapter(0)}));select?.addEventListener('change',()=>showChapter(Number(select.value)));reader?.querySelector('[data-close]')?.addEventListener('click',()=>reader.close());reader?.addEventListener('click',e=>{if(e.target===reader)reader.close()});
</script>
<style>
.fiction-visual{overflow:hidden;padding:clamp(8rem,14vh,10rem) clamp(2rem,7vw,8rem) 3rem;background:radial-gradient(circle at 78% 14%,#b58bbc55,transparent 30%),linear-gradient(120deg,#eee4eb,#d8c7dc);color:#382a3d}.fiction-visual>header{max-width:1100px;margin:auto}.fiction-visual header p{margin:0;color:#754b80;font:700 .7rem sans-serif;letter-spacing:.26em}.fiction-visual h1{margin:.3rem 0;font-size:clamp(2.7rem,5vw,5.3rem);font-weight:500;letter-spacing:.08em}.fiction-visual header span{letter-spacing:.12em}.archive-link{display:table;margin-top:.9rem;padding:.42rem .72rem;border:1px solid #704b7040;border-radius:999px;color:#654367;background:#fff3;font:600 .72rem/1.3 sans-serif;letter-spacing:.04em;text-decoration:none;transition:color .2s,background .2s,border-color .2s,transform .2s}.archive-link i{font-style:normal}.archive-link:hover,.archive-link:focus-visible{border-color:#704b7080;color:#49304b;background:#fff8;transform:translateY(-1px)}.shelf{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 9rem)/4);align-items:end;gap:3rem;width:min(1100px,100%);height:46vh;margin:1.25rem auto 0;padding:1rem 3rem 3rem;box-sizing:border-box;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x proximity;border-bottom:18px solid #503851;box-shadow:0 20px 18px -17px #321d32aa}.library-notices{display:flex;align-items:baseline;gap:1rem;max-width:1100px;margin:.85rem auto 0;font-family:sans-serif;line-height:1.6;letter-spacing:.04em}.library-notices strong{flex:none;color:#654367;font-size:.72rem}.library-notices p{margin:0;color:#5e4d606e;font-size:.66rem}.book{position:relative;width:100%;height:290px;padding:0;border:0;background:none;cursor:pointer;perspective:800px;scroll-snap-align:start;transition:transform .35s}.book:hover{transform:translateY(-14px)}.pages{position:absolute;inset:5px 0 0 12px;border-radius:2px 9px 9px 2px;background:repeating-linear-gradient(0deg,#eee8df 0 3px,#c9beb1 4px);box-shadow:8px 8px 12px #321f3033}.cover{position:absolute;z-index:1;inset:0 8px 7px 0;display:flex;flex-direction:column;justify-content:flex-end;padding:1.5rem;text-align:left;color:#fff;background:linear-gradient(145deg,#ffffff22,transparent 35%),#523255;border-left:9px solid #372039;border-radius:3px 9px 9px 3px;box-shadow:8px 13px 22px #2f1b313f;transform-origin:left;transition:transform .5s}.book:hover .cover{transform:rotateY(-11deg)}.cover i{position:absolute;top:1.5rem;right:1rem;color:#d2add5;font:600 .65rem sans-serif;letter-spacing:.17em}.cover strong{font-size:1.5rem;line-height:1.3}.cover small{margin-top:.8rem;color:#dbc5dd}.number{position:absolute;right:2rem;bottom:1rem;color:#39233c66;font:normal .7rem sans-serif;letter-spacing:.24em}@media(max-width:700px){.library-notices{display:block}.library-notices p{margin-top:.25rem}}
.reader{width:min(980px,calc(100vw - 2rem));height:min(84vh,850px);padding:0;border:0;overflow:visible;background:transparent}.reader::backdrop{background:#160f19bd;backdrop-filter:blur(10px)}.paper{display:grid;grid-template-columns:240px 1fr;height:100%;overflow:hidden;background:#f3ecdf;box-shadow:0 25px 80px #0008;color:#40352e}.paper aside{padding:4rem 1.4rem 2rem;border-right:1px solid #9b887744;background:#e9dfd1}.paper aside b{display:block;margin-bottom:2rem;font-size:1.1rem}.paper nav{display:grid;gap:.4rem}.paper nav button{padding:.65rem;border:0;text-align:left;color:#6c5a52;background:transparent;cursor:pointer}.paper nav button.active{color:#6f3f70;background:#fff8}.paper select{display:none;width:100%}.paper article{overflow-y:auto;padding:clamp(3rem,7vw,6rem);font-family:serif;line-height:2.15;letter-spacing:.07em}.paper article header{display:flex;flex-direction:column;align-items:center;margin:0 0 2.5rem;text-align:center}.paper article h2{margin:0;font-size:2rem;font-weight:500;line-height:1.35}.paper article header .work-links{display:flex;flex-direction:column;align-items:center;gap:.42rem;margin-top:.85rem;font:normal .64rem/1.4 sans-serif;letter-spacing:.03em}.paper article header .work-source{color:#76657880;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.22em}.paper article header .work-source:hover{color:#704b70}.paper article header .related-video{display:inline-flex!important;align-items:center;gap:.42rem;padding:.42rem .82rem!important;border:1px solid #805b7c55!important;border-radius:999px!important;color:#62405f!important;background:#8e628517!important;text-decoration:none!important;box-shadow:0 3px 10px #55304e10!important;line-height:1.2!important}.paper article header .related-video:hover{border-color:#76507388!important;color:#4f304d!important;background:#8e628524!important}.paper article header .related-video span{font-size:.5rem;color:#8b6388}.paper article>p{margin:1.15em 0;text-indent:2em;font-size:1.05rem}.paper article footer{display:flex;justify-content:space-between;align-items:center;margin-top:4rem;padding-top:1.5rem;border-top:1px solid #8e7a6944}.paper article footer button{border:0;color:#704b70;background:transparent;cursor:pointer}.paper article footer button:disabled{opacity:.3}.close{position:absolute;z-index:3;right:-1rem;top:-1rem;width:46px;height:46px;border:1px solid #fff8;border-radius:50%;color:#fff;background:#503752;font-size:2rem;cursor:pointer}.close:hover{transform:rotate(90deg)}@media(max-width:700px){.paper{display:block}.paper aside{padding:3.5rem 2rem 1rem;border:0}.paper nav{display:none}.paper select{display:block}.paper article{height:calc(100% - 130px);padding:2rem}.paper article header{margin-bottom:2rem}.close{right:.2rem;top:.2rem}}
</style>
<style is:global>
.fiction-page .reader .work-links{display:flex;flex-direction:column;align-items:center;gap:.42rem;margin-top:.85rem;font:normal .64rem/1.4 sans-serif;letter-spacing:.03em}
.fiction-page .reader .work-source{color:#76657880;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.22em}
.fiction-page .reader .work-source:hover{color:#704b70}
.fiction-page .reader .work-source-text{cursor:default;text-decoration:none}
.fiction-page .reader .work-source-text:hover{color:#76657880}
.fiction-page .reader .related-video{display:inline-flex;align-items:center;gap:.42rem;padding:.42rem .82rem;border:1px solid #805b7c55;border-radius:999px;color:#62405f;background:#8e628517;text-decoration:none;box-shadow:0 3px 10px #55304e10;line-height:1.2}
.fiction-page .reader .related-video:hover{border-color:#76507388;color:#4f304d;background:#8e628524}
.fiction-page .reader .related-video span{font-size:.5rem;color:#8b6388}
@media(max-width:700px){
  .fiction-page .fiction-visual{overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;padding:92px 18px calc(30px + env(safe-area-inset-bottom,0px))}
  .fiction-page .fiction-visual h1{font-size:2.65rem}.fiction-page .fiction-visual header span{font-size:.78rem;line-height:1.6}.fiction-page .archive-link{margin-top:12px;font-size:.68rem}
  .fiction-page .shelf{display:flex;height:300px;gap:20px;margin-top:22px;padding:12px 18px 26px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x proximity}.fiction-page .book{flex:0 0 160px;width:160px;height:225px;scroll-snap-align:start}.fiction-page .cover{padding:1rem}.fiction-page .cover i{top:1rem;font-size:.5rem}.fiction-page .cover strong{font-size:1.15rem}
  .fiction-page .library-notices{margin-top:18px}.fiction-page .number{display:none}
  .fiction-page .reader{width:100vw;height:100dvh;max-height:none;margin:0;overflow:hidden}.fiction-page .paper aside{height:132px;padding:calc(52px + env(safe-area-inset-top,0px)) 18px 12px}.fiction-page .paper aside b{margin-bottom:8px;font-size:.95rem}.fiction-page .paper select{min-height:40px;padding:0 9px;border:1px solid #8d786755;border-radius:4px;background:#f8f1e7;color:#54453f}.fiction-page .paper article{height:calc(100% - 132px);padding:25px 20px calc(34px + env(safe-area-inset-bottom,0px));font-size:1rem}.fiction-page .paper article h2{font-size:1.55rem}.fiction-page .paper article>p{font-size:1rem;line-height:2}.fiction-page .close{position:fixed;top:max(8px,env(safe-area-inset-top,0px));right:9px;width:40px;height:40px;font-size:1.6rem}
}
</style>
