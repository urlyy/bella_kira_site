---
import { readdir, readFile } from "node:fs/promises";
import { imageSize } from "image-size";
import cardManifest from "../../../public/assets/flash-cards/manifest.json";
import FlashCardViewer from "../FlashCardViewer.astro";

const galleryDirectory = new URL(
	"../../../public/assets/gallery/",
	import.meta.url,
);
const supportedImageExtensions = new Set([
	".avif",
	".gif",
	".jpeg",
	".jpg",
	".png",
	".webp",
]);
const galleryEntries = (
	await readdir(galleryDirectory, { withFileTypes: true })
)
	.filter((entry) => {
		if (!entry.isFile()) return false;
		const extension = entry.name
			.slice(entry.name.lastIndexOf("."))
			.toLowerCase();
		return supportedImageExtensions.has(extension);
	})
	.sort((a, b) => a.name.localeCompare(b.name, "zh-CN", { numeric: true }));
const galleryItems = await Promise.all(
	galleryEntries.map(async (entry) => {
		const dimensions = imageSize(
			await readFile(new URL(entry.name, galleryDirectory)),
		);
		const card = cardManifest.cards.find(
			(card) => card.file === entry.name,
		);
		return {
			configUrl: card?.configUrl,
			originalSrc: `/assets/gallery/${encodeURIComponent(entry.name)}`,
			previewSrc: `/assets/gallery/previews/${encodeURIComponent(`${entry.name}.webp`)}`,
			alt: entry.name.replace(/\.[^.]+$/, ""),
			width: dimensions.width ?? 1,
			height: dimensions.height ?? 1,
		};
	}),
);
---

<section
	class="page gallery-page"
	data-page-name="gallery"
	aria-label="收藏集图片"
>
	<div class="page-visual gallery-scroll-surface gallery-visual">
		<header>
			<p>GALLERY · BELLA KIRA</p>
			<h1>收藏集图片</h1>
			<span>沿着每一帧，再看贝拉绽放光彩。</span>
			<small class="gallery-quality-hint">
				<i aria-hidden="true">✦</i>
				点击卡面，原地转动 3D 闪卡；也可单独查看原图
			</small>
		</header>
		<div class="gallery-next-row">
			<a class="gallery-next" href="/#fiction" data-page="8">
				<span>
					<small>NEXT · FAN FICTION</small>
					前往同人文
				</span>
				<i aria-hidden="true">→</i>
			</a>
		</div>
		<div class="waterfall" data-gallery-grid>
			{
				galleryItems.map((item, index) => (
					<figure
						data-gallery-item
						data-aspect-ratio={item.width / item.height}
					>
						<button
							type="button"
							class="gallery-card"
							data-card-config={item.configUrl}
							aria-haspopup="dialog"
							aria-label={`打开 ${item.alt} 3D 闪卡`}
						>
							<img
								data-src={item.previewSrc}
								alt={item.alt}
								width={item.width}
								height={item.height}
								loading="lazy"
								decoding="async"
								draggable="false"
							/>
							<span class="gallery-card-label">转动闪卡</span>
						</button>
						<button
							class="gallery-original"
							type="button"
							data-gallery-open
							data-gallery-index={index}
							data-original-src={item.originalSrc}
							aria-label={`放大查看 ${item.alt}`}
						>
							查看原图
						</button>
					</figure>
				))
			}
		</div>
	</div>
	<dialog
		class="gallery-card-dialog"
		data-gallery-card-dialog
		aria-label="3D 闪卡预览"
	>
		<button
			class="card-dialog-close"
			type="button"
			data-card-close
			autofocus
			aria-label="关闭闪卡预览">×</button
		>
		<FlashCardViewer />
	</dialog>
	<dialog
		class="gallery-lightbox"
		data-gallery-lightbox
		aria-label="图片放大查看"
	>
		<button
			class="lightbox-close"
			type="button"
			data-lightbox-close
			aria-label="关闭图片查看">×</button
		>
		<button
			class="lightbox-nav lightbox-previous"
			type="button"
			data-lightbox-previous
			aria-label="查看上一张图片">←</button
		>
		<div class="lightbox-image-wrap" data-lightbox-image-wrap>
			<img data-lightbox-image alt="" draggable="false" />
			<span class="lightbox-loading" role="status">正在载入原图</span>
		</div>
		<button
			class="lightbox-nav lightbox-next"
			type="button"
			data-lightbox-next
			aria-label="查看下一张图片">→</button
		>
		<span class="lightbox-count" data-lightbox-count aria-live="polite"
		></span>
	</dialog>
</section>

<script>
	import { setupGalleryCards } from "../../scripts/flash-card/gallery";
	setupGalleryCards();

	const galleryGrid = document.querySelector<HTMLElement>(
		"[data-gallery-grid]",
	);
	const galleryItems = Array.from(
		document.querySelectorAll<HTMLElement>("[data-gallery-item]"),
	);
	const gallerySurface =
		document.querySelector<HTMLElement>(".gallery-visual");
	let galleryImagesInitialized = false;
	const galleryImageObserver = new IntersectionObserver(
		(entries, observer) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				const image = entry.target as HTMLImageElement;
				if (image.dataset.src) image.src = image.dataset.src;
				observer.unobserve(image);
			});
		},
		{ root: gallerySurface, rootMargin: "500px 0px", threshold: 0.01 },
	);
	const initializeGalleryImages = () => {
		if (galleryImagesInitialized) return;
		galleryImagesInitialized = true;
		galleryItems.forEach((item) => {
			const image = item.querySelector<HTMLImageElement>("img[data-src]");
			if (image) galleryImageObserver.observe(image);
		});
	};
	window.addEventListener("bella:pagewillchange", (event) => {
		if (
			(event as CustomEvent<{ toHash?: string }>).detail?.toHash ===
			"#gallery"
		)
			initializeGalleryImages();
	});
	if (window.location.hash === "#gallery") initializeGalleryImages();

	const layoutGallery = () => {
		if (!galleryGrid) return;
		const styles = getComputedStyle(galleryGrid);
		const rowHeight = Number.parseFloat(styles.gridAutoRows);
		const rowGap = Number.parseFloat(styles.rowGap);

		galleryItems.forEach((item) => {
			const aspectRatio = Number(item.dataset.aspectRatio);
			if (!aspectRatio) return;
			const displayedHeight = item.clientWidth / aspectRatio;
			item.style.gridRowEnd = `span ${Math.ceil((displayedHeight + rowGap) / (rowHeight + rowGap))}`;
		});
	};

	galleryItems.forEach((item) => {
		item.querySelector("img")?.addEventListener("load", layoutGallery, {
			once: true,
		});
	});
	new ResizeObserver(layoutGallery).observe(galleryGrid as HTMLElement);
	layoutGallery();

	const lightbox = document.querySelector<HTMLDialogElement>(
		"[data-gallery-lightbox]",
	);
	const lightboxImage = lightbox?.querySelector<HTMLImageElement>(
		"[data-lightbox-image]",
	);
	const lightboxImageWrap = lightbox?.querySelector<HTMLElement>(
		"[data-lightbox-image-wrap]",
	);
	const lightboxCount = lightbox?.querySelector<HTMLElement>(
		"[data-lightbox-count]",
	);
	const openButtons = Array.from(
		document.querySelectorAll<HTMLButtonElement>("[data-gallery-open]"),
	);
	let activeImageIndex = 0;
	let imageRequestId = 0;

	const showLightboxImage = (index: number) => {
		if (!lightboxImage || galleryItems.length === 0) return;
		activeImageIndex = (index + galleryItems.length) % galleryItems.length;
		const sourceImage =
			galleryItems[activeImageIndex]?.querySelector<HTMLImageElement>(
				"img",
			);
		const openButton = galleryItems[
			activeImageIndex
		]?.querySelector<HTMLButtonElement>("[data-gallery-open]");
		const originalSrc = openButton?.dataset.originalSrc;
		if (!sourceImage || !originalSrc) return;
		const requestId = ++imageRequestId;
		lightboxImage.src =
			sourceImage.currentSrc ||
			sourceImage.src ||
			sourceImage.dataset.src ||
			"";
		lightboxImage.alt = sourceImage.alt;
		lightboxImageWrap?.setAttribute("data-loading", "true");
		if (lightboxCount)
			lightboxCount.textContent = `${activeImageIndex + 1} / ${galleryItems.length}`;

		const originalImage = new Image();
		originalImage.decoding = "async";
		originalImage.src = originalSrc;
		originalImage
			.decode()
			.then(() => {
				if (
					requestId !== imageRequestId ||
					!originalImage.complete ||
					originalImage.naturalWidth === 0
				)
					return;
				lightboxImage.src = originalSrc;
				lightboxImageWrap?.removeAttribute("data-loading");
			})
			.catch(() => {
				if (requestId !== imageRequestId) return;
				lightboxImageWrap?.removeAttribute("data-loading");
			});
	};

	openButtons.forEach((button) => {
		button.addEventListener("click", () => {
			showLightboxImage(Number(button.dataset.galleryIndex) || 0);
			lightbox?.showModal();
		});
	});

	lightbox
		?.querySelector("[data-lightbox-close]")
		?.addEventListener("click", () => lightbox.close());
	lightbox
		?.querySelector("[data-lightbox-previous]")
		?.addEventListener("click", () =>
			showLightboxImage(activeImageIndex - 1),
		);
	lightbox
		?.querySelector("[data-lightbox-next]")
		?.addEventListener("click", () =>
			showLightboxImage(activeImageIndex + 1),
		);
	lightbox?.addEventListener("click", (event) => {
		if (event.target === lightbox) lightbox.close();
	});
	lightbox?.addEventListener("keydown", (event) => {
		if (event.key === "Escape") {
			event.preventDefault();
			lightbox.close();
			return;
		}
		if (event.key === "ArrowLeft") showLightboxImage(activeImageIndex - 1);
		if (event.key === "ArrowRight") showLightboxImage(activeImageIndex + 1);
	});
	lightbox?.addEventListener("close", () => {
		imageRequestId += 1;
		lightboxImageWrap?.removeAttribute("data-loading");
		lightboxImage?.removeAttribute("src");
	});
</script>

<style>
	.gallery-card-dialog {
		width: min(1200px, calc(100vw - 48px));
		height: min(900px, calc(100dvh - 48px));
		max-width: none;
		max-height: none;
		padding: 0;
		margin: auto;
		overflow: hidden;
		border: 1px solid #c8a5c83b;
		border-radius: 12px;
		background: #19121f;
		box-shadow: 0 24px 90px #08050b66;
	}
	.gallery-card-dialog::backdrop {
		background: #100919ba;
		backdrop-filter: blur(8px);
	}
	.card-dialog-close {
		position: absolute;
		top: max(8px, env(safe-area-inset-top));
		right: max(10px, env(safe-area-inset-right));
		z-index: 10;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: #35273e;
		color: #fff4ee;
		font: 26px/1 sans-serif;
		cursor: pointer;
	}
	.card-dialog-close:focus-visible {
		outline: 2px solid #db7d74;
		outline-offset: 2px;
	}
	@media (max-width: 760px) {
		.gallery-card-dialog {
			width: calc(100vw - 16px);
			height: calc(100dvh - 24px);
			border-radius: 8px;
		}
	}
	@media (max-height: 500px) and (orientation: landscape) {
		.gallery-card-dialog {
			height: calc(100dvh - 16px);
		}
	}

	.gallery-card {
		display: block;
		position: relative;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		background: none;
		color: white;
		text-decoration: none;
		cursor: pointer;
	}
	.gallery-card-label,
	.gallery-original {
		position: absolute;
		bottom: 10px;
		padding: 8px 10px;
		border: 1px solid #ffffff50;
		border-radius: 999px;
		background: #211329df;
		color: #fff6ef;
		font: 12px/1.4 sans-serif;
	}
	.gallery-card-label {
		left: 10px;
		pointer-events: none;
	}
	.gallery-original {
		right: 10px;
		min-height: 36px;
		cursor: pointer;
	}
	.gallery-card:focus-visible,
	.gallery-original:focus-visible {
		outline: 2px solid #f1bbad;
		outline-offset: -3px;
	}
	@media (max-width: 420px) {
		.gallery-card-label,
		.gallery-original {
			font-size: 10px;
			padding: 7px;
			bottom: 7px;
		}
		.gallery-card-label {
			left: 6px;
		}
		.gallery-original {
			right: 6px;
		}
	}

	.gallery-visual {
		overflow-x: hidden;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: clamp(7.5rem, 12vh, 9rem) clamp(1.5rem, 5vw, 5rem) 2rem;
		color: #fff;
		background:
			radial-gradient(circle at 12% 16%, #593562 0, transparent 28%),
			linear-gradient(135deg, #19121f, #2b1834 55%, #111018);
	}
	.gallery-visual > header {
		max-width: 1200px;
		margin: 0 auto 1.3rem;
	}
	.gallery-visual header p {
		margin: 0;
		color: #dba9ed;
		font-family: var(--chapter-kicker-font-family);
		font-size: var(--chapter-kicker-font-size);
		font-weight: 700;
		line-height: 1.4;
		letter-spacing: 0.28em;
	}
	.gallery-visual h1 {
		margin: 0.2rem 0;
		font-size: clamp(2.3rem, 4vw, 4.4rem);
		font-weight: 500;
		letter-spacing: 0.08em;
	}
	.gallery-visual header span {
		color: #d9cedd;
		font-family: var(--chapter-subtitle-font-family);
		font-size: var(--chapter-subtitle-font-size);
		letter-spacing: 0.12em;
	}
	.gallery-quality-hint {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: fit-content;
		margin-top: 0.8rem;
		color: #cbb9d0;
		font: 400 0.7rem/1.5 sans-serif;
		letter-spacing: 0.08em;
	}
	.gallery-quality-hint i {
		color: #db7d74;
		font-style: normal;
		text-shadow: 0 0 10px #db7d7480;
	}
	.gallery-next-row {
		display: flex;
		justify-content: flex-end;
		max-width: 1200px;
		margin: 0 auto 1rem;
	}
	.gallery-next {
		display: inline-flex;
		align-items: center;
		gap: 1.2rem;
		min-width: min(100%, 240px);
		padding: 0.72rem 0.85rem 0.72rem 1rem;
		border: 1px solid #dba9ed4d;
		border-radius: 4px;
		color: #f7edf9;
		background: #ffffff0d;
		text-decoration: none;
		box-shadow: inset 0 1px #ffffff12;
		transition:
			border-color 180ms ease,
			background-color 180ms ease,
			translate 180ms ease;
	}
	.gallery-next span {
		display: grid;
		gap: 0.16rem;
		font-size: 0.78rem;
		letter-spacing: 0.12em;
	}
	.gallery-next small {
		color: #dba9ed;
		font: 700 0.52rem sans-serif;
		letter-spacing: 0.2em;
	}
	.gallery-next i {
		display: grid;
		flex: none;
		place-items: center;
		width: 2rem;
		height: 2rem;
		margin-left: auto;
		border-radius: 50%;
		color: #25162b;
		background: #ead4ee;
		font-family: sans-serif;
		font-style: normal;
		transition: translate 180ms ease;
	}
	.gallery-next:hover,
	.gallery-next:focus-visible {
		border-color: #e6c4ecaa;
		background: #ffffff17;
		outline: none;
		translate: 0 -2px;
	}
	.gallery-next:hover i,
	.gallery-next:focus-visible i {
		translate: 3px 0;
	}
	.waterfall {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-auto-rows: 4px;
		gap: 12px 16px;
		max-width: 1200px;
		margin: auto;
	}
	.waterfall figure {
		position: relative;
		min-width: 0;
		margin: 0;
		overflow: hidden;
		border-radius: 5px;
		background: #392a41;
	}
	.waterfall img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition:
			transform 320ms ease,
			filter 220ms ease;
	}
	.waterfall figure:hover img,
	.gallery-card:focus-visible img {
		filter: saturate(1.08);
		transform: scale(1.025);
	}
	.gallery-lightbox {
		box-sizing: border-box;
		width: 100vw;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: clamp(1rem, 3vw, 2.5rem);
		border: 0;
		overflow: hidden;
		color: #fff;
		background: #100b16f2;
	}
	.gallery-lightbox[open] {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		grid-template-rows: minmax(0, 1fr);
		align-items: center;
		gap: clamp(0.5rem, 2vw, 1.5rem);
	}
	.gallery-lightbox::backdrop {
		background: #07050bd9;
		backdrop-filter: blur(10px);
	}
	.lightbox-image-wrap {
		position: relative;
		display: grid;
		min-width: 0;
		min-height: 0;
		height: 100%;
		place-items: center;
		overflow: hidden;
	}
	.lightbox-image-wrap img {
		display: block;
		max-width: 100%;
		max-height: calc(100dvh - 5rem);
		width: auto;
		height: auto;
		object-fit: contain;
		filter: drop-shadow(0 20px 55px #000a);
	}
	.lightbox-loading {
		position: absolute;
		left: 50%;
		bottom: clamp(0.8rem, 3vh, 1.5rem);
		padding: 0.5rem 0.75rem;
		border: 1px solid #ffffff24;
		border-radius: 999px;
		color: #f1e7f3;
		background: #160f1dcc;
		font: 0.65rem/1 sans-serif;
		letter-spacing: 0.12em;
		opacity: 0;
		pointer-events: none;
		translate: -50% 0.4rem;
		transition:
			opacity 160ms ease,
			translate 160ms ease;
	}
	.lightbox-image-wrap[data-loading="true"] .lightbox-loading {
		opacity: 1;
		translate: -50% 0;
	}
	.lightbox-close,
	.lightbox-nav {
		z-index: 2;
		display: grid;
		place-items: center;
		width: 2.8rem;
		height: 2.8rem;
		padding: 0;
		border: 1px solid #ffffff42;
		border-radius: 50%;
		color: #fff;
		background: #ffffff10;
		cursor: pointer;
		font: 300 1.15rem/1 sans-serif;
		transition:
			border-color 180ms ease,
			background-color 180ms ease,
			scale 180ms ease;
	}
	.lightbox-close {
		position: absolute;
		top: clamp(1rem, 3vw, 2rem);
		right: clamp(1rem, 3vw, 2rem);
		font-size: 1.7rem;
	}
	.lightbox-close:hover,
	.lightbox-close:focus-visible,
	.lightbox-nav:hover,
	.lightbox-nav:focus-visible {
		border-color: #efd9f2;
		background: #ffffff22;
		outline: none;
		scale: 1.06;
	}
	.lightbox-count {
		position: absolute;
		bottom: 1rem;
		left: 50%;
		color: #e5d4e8b8;
		font: 0.65rem sans-serif;
		letter-spacing: 0.2em;
		translate: -50% 0;
	}
	@media (max-width: 900px) {
		.waterfall {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 600px) {
		.gallery-visual {
			padding: calc(88px + env(safe-area-inset-top, 0px)) 14px
				calc(28px + env(safe-area-inset-bottom, 0px));
		}
		.gallery-visual h1 {
			font-size: 2.55rem;
		}
		.gallery-visual header span {
			font-size: var(--chapter-subtitle-font-size);
		}
		.gallery-next-row {
			justify-content: stretch;
		}
		.gallery-next {
			width: 100%;
		}
		.waterfall {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.gallery-lightbox {
			padding: calc(3.8rem + env(safe-area-inset-top, 0px)) 0.75rem
				calc(3rem + env(safe-area-inset-bottom, 0px));
		}
		.gallery-lightbox[open] {
			grid-template-columns: 1fr 1fr;
			grid-template-rows: minmax(0, 1fr) auto;
		}
		.lightbox-image-wrap {
			grid-column: 1 / -1;
			grid-row: 1;
		}
		.lightbox-image-wrap img {
			max-height: calc(100dvh - 8.5rem);
		}
		.lightbox-nav {
			grid-row: 2;
			justify-self: center;
		}
		.lightbox-previous {
			grid-column: 1;
		}
		.lightbox-next {
			grid-column: 2;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.gallery-next,
		.gallery-next i {
			transition: none;
		}
		.lightbox-close,
		.lightbox-nav {
			transition: none;
		}
		.lightbox-loading {
			transition: none;
		}
		.waterfall img {
			transition: none;
		}
		.waterfall figure:hover img {
			transform: none;
		}
	}
</style>
