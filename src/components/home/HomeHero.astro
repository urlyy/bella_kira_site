<section class="page hero is-current" data-page-name="home" aria-label="首页">
	<div class="page-visual">
		<video
			class="hero-video"
			autoplay
			muted
			loop
			playsinline
			preload="auto"
		>
			<source
				src="/assets/optimized/video/hero-1080p.mp4"
				type="video/mp4"
			/>
		</video>
		<div class="hero-media-controls" aria-label="首页视频控制">
			<button
				class="hero-media-button hero-play-toggle"
				type="button"
				aria-label="暂停首页视频"
			>
				<span aria-hidden="true">Ⅱ</span>
				<span class="hero-control-label">暂停</span>
			</button>
			<button
				class="hero-media-button hero-speed-toggle"
				type="button"
				aria-label="切换视频播放速度"
			>
				<span class="hero-speed-value" aria-hidden="true">1×</span>
				<span class="hero-control-label">倍速</span>
			</button>
		</div>
	</div>
</section>
