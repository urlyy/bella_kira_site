---
import { readFile } from "node:fs/promises";

const clothManifest = JSON.parse(
  await readFile(new URL("../../../public/assets/optimized/cloth-bg/manifest.json", import.meta.url), "utf8"),
);
const versionedBackground = (name: string) => {
  const entry = Object.values(clothManifest.images).find((image: any) => image.output === name) as any;
  return `/assets/optimized/cloth-bg/${name}?v=${entry.outputHash.slice(0, 12)}`;
};
const outfits = [
  {
    image: "/assets/optimized/clothes/毕方.webp",
    background: versionedBackground("毕方.webp"),
    backgroundFit: "cover",
    width: 668,
    height: 2048,
  },
  {
    image: "/assets/optimized/clothes/常服.webp",
    background: versionedBackground("常服.webp"),
    backgroundFit: "cover",
    width: 613,
    height: 2048,
  },
  {
    image: "/assets/optimized/clothes/松鼠睡衣.webp",
    background: versionedBackground("松鼠睡衣.webp"),
    backgroundFit: "cover",
    backgroundPosition: "center top",
    width: 726,
    height: 2048,
  },
  {
    image: "/assets/optimized/clothes/25年生日服.webp",
    background: versionedBackground("25生日会.webp"),
    backgroundFit: "cover",
    backgroundPosition: "center top",
    width: 604,
    height: 2048,
  },
  {
    image: "/assets/optimized/clothes/白拉.webp",
    background: versionedBackground("白拉.webp"),
    backgroundFit: "cover",
    width: 998,
    height: 2048,
  },
  {
    image: "/assets/optimized/clothes/jk绿.webp",
    background: versionedBackground("绿jk.webp"),
    backgroundFit: "cover",
    backgroundPosition: "center top",
    width: 596,
    height: 2048,
  },
  {
    image: "/assets/optimized/clothes/22年生日服.webp",
    background: versionedBackground("22生日会.webp"),
    backgroundFit: "cover",
    backgroundPosition: "center top",
    width: 690,
    height: 2048,
  },
  {
    image: "/assets/optimized/clothes/五周年团服.webp",
    background: versionedBackground("五周年团服.webp"),
    backgroundFit: "cover",
    backgroundPosition: "center top",
    width: 586,
    height: 2048,
  },
];

// Keep enough planes on the ring to make its depth readable while the archive is
// still small. Once there are nine or more outfits, every outfit owns one plane.
const ringSize = Math.ceil(Math.max(9, outfits.length) / outfits.length) * outfits.length;
const ringItems = Array.from({ length: ringSize }, (_, slot) => ({
  ...outfits[slot % outfits.length],
  slot,
  itemIndex: slot % outfits.length,
}));
---

<section class="page outfit-page" data-page-name="outfits" aria-label="服装展示">
  <div class="outfit-backgrounds" aria-hidden="true">
    <span class="outfit-background is-active" data-source={outfits[0].background} data-fit={outfits[0].backgroundFit} data-position={outfits[0].backgroundPosition ?? "center"} style={`--outfit-bg-position: ${outfits[0].backgroundPosition ?? "center"}`}>
      <img class="outfit-background-blur" data-src={outfits[0].background} alt="" decoding="async" draggable="false" />
      <img class="outfit-background-art" data-src={outfits[0].background} alt="" decoding="async" draggable="false" />
    </span>
    <span class="outfit-background" data-source={outfits[0].background} data-fit={outfits[0].backgroundFit} data-position={outfits[0].backgroundPosition ?? "center"} style={`--outfit-bg-position: ${outfits[0].backgroundPosition ?? "center"}`}>
      <img class="outfit-background-blur" data-src={outfits[0].background} alt="" decoding="async" draggable="false" />
      <img class="outfit-background-art" data-src={outfits[0].background} alt="" decoding="async" draggable="false" />
    </span>
  </div>
  <div class="outfit-wash" aria-hidden="true"></div>
  <div class="outfit-rays" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="outfit-change-flash" data-outfit-change-flash aria-hidden="true"></div>

  <header class="outfit-heading">
    <p>BELLA · OUTFIT ARCHIVE</p>
    <h1>服装展示</h1>
    <span>沿着星轨，遇见每一种贝拉</span>
  </header>

  <div
    class="outfit-carousel"
    data-outfit-carousel
    data-ring-size={ringSize}
    tabindex="0"
    role="region"
    aria-roledescription="循环轮播"
    aria-label="贝拉服装轮播，可左右拖动或使用方向按钮"
  >
    <div class="outfit-orbit" aria-hidden="true">
      <i></i><i></i><i></i>
      <span class="outfit-orbit-stars">
        {Array.from({ length: 54 }, (_, index) => {
          const angle = index * 2.399963;
          const radius = Math.sqrt((index + 0.5) / 54);
          const x = 50 + Math.cos(angle) * radius * 47;
          const y = 50 + Math.sin(angle) * radius * 44;
          return <b style={`--star-index:${index};--star-x:${x.toFixed(2)}%;--star-y:${y.toFixed(2)}%`}></b>;
        })}
      </span>
    </div>
    <div class="outfit-stage" data-outfit-stage>
      {ringItems.map((item) => (
        <button
          class="outfit-plane"
          type="button"
          data-outfit-plane
          data-slot={item.slot}
          data-item-index={item.itemIndex}
          data-outfit-background={item.background}
          data-outfit-background-fit={item.backgroundFit}
          data-outfit-background-position={item.backgroundPosition ?? "center"}
          aria-label={`选择第 ${item.itemIndex + 1} 套服装`}
          tabindex="-1"
        >
          <span class="outfit-figure">
            <img
              data-src={item.image}
              alt=""
              width={item.width}
              height={item.height}
              decoding="async"
              draggable="false"
            />
          </span>
          <span class="outfit-reflection" aria-hidden="true">
            <img data-src={item.image} alt="" width={item.width} height={item.height} decoding="async" draggable="false" />
          </span>
        </button>
      ))}
    </div>

    <button class="outfit-arrow outfit-arrow-previous" type="button" data-outfit-previous aria-label="上一套服装">
      <i aria-hidden="true"></i><span>PREV</span>
    </button>
    <button class="outfit-arrow outfit-arrow-next" type="button" data-outfit-next aria-label="下一套服装">
      <span>NEXT</span><i aria-hidden="true"></i>
    </button>
  </div>

  <div class="outfit-current" aria-live="polite">
    <span data-outfit-number>01</span>
    <div><small>CURRENT OUTFIT</small></div>
    <i aria-hidden="true"></i>
  </div>

  <p class="outfit-instruction"><i aria-hidden="true"></i> 左右拖动 · 或使用两侧箭头</p>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>("[data-outfit-carousel]");
  const stage = carousel?.querySelector<HTMLElement>("[data-outfit-stage]");
  const planes = Array.from(carousel?.querySelectorAll<HTMLButtonElement>("[data-outfit-plane]") ?? []);
  const previousButton = carousel?.querySelector<HTMLButtonElement>("[data-outfit-previous]");
  const nextButton = carousel?.querySelector<HTMLButtonElement>("[data-outfit-next]");
  const page = carousel?.closest<HTMLElement>(".outfit-page");
  const backgrounds = Array.from(page?.querySelectorAll<HTMLElement>(".outfit-background") ?? []);
  const currentNumber = page?.querySelector<HTMLElement>("[data-outfit-number]");
  const changeFlash = page?.querySelector<HTMLElement>("[data-outfit-change-flash]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (carousel && stage && planes.length) {
    const ringSize = Number(carousel.dataset.ringSize) || planes.length;
    const stepAngle = (Math.PI * 2) / ringSize;
    let angle = 0;
    let targetAngle = 0;
    let frame = 0;
    let motionStartedAt = 0;
    let motionStartAngle = 0;
    let motionEndAngle = 0;
    let activeItemIndex = -1;
    let activeBackground = 0;
    let initialized = false;
    let dragging = false;
    let pointerId = -1;
    let pointerStartX = 0;
    let pointerStartAngle = 0;
    let pointerMoved = false;
    let autoplayTimer = 0;
    let isOutfitPageActive = window.location.hash === "#outfits";
    const autoplayDelay = 3200;

    const normalizeAngle = (value: number) => Math.atan2(Math.sin(value), Math.cos(value));
    const modulo = (value: number, divisor: number) => ((value % divisor) + divisor) % divisor;

    const stopAutoplay = () => {
      if (!autoplayTimer) return;
      window.clearTimeout(autoplayTimer);
      autoplayTimer = 0;
    };

    const scheduleAutoplay = () => {
      stopAutoplay();
      if (!initialized || !isOutfitPageActive || reducedMotion.matches || document.hidden) return;
      autoplayTimer = window.setTimeout(() => {
        autoplayTimer = 0;
        if (!frame && !dragging && isOutfitPageActive) moveBy(-1);
        else scheduleAutoplay();
      }, autoplayDelay);
    };

    const setBackground = (src: string, fit: string, position: string) => {
      const current = backgrounds[activeBackground];
      if (!current || current.dataset.source === src) {
        if (current) current.dataset.source = src;
        if (current) {
          current.dataset.fit = fit;
          current.dataset.position = position;
          current.style.setProperty("--outfit-bg-position", position);
        }
        return;
      }
      const incomingIndex = activeBackground === 0 ? 1 : 0;
      const incoming = backgrounds[incomingIndex];
      if (!incoming) return;
      if (changeFlash && !reducedMotion.matches) {
        changeFlash.getAnimations().forEach((animation) => animation.cancel());
        changeFlash.animate([
          { opacity: 0, transform: "translate3d(-48vw,0,0) rotate(10deg)" },
          { opacity: .72, offset: .46 },
          { opacity: 0, transform: "translate3d(48vw,0,0) rotate(10deg)" },
        ], { duration: 860, easing: "cubic-bezier(.28,.05,.18,1)", fill: "both" });
      }
      incoming.classList.remove("is-ready");
      incoming.dataset.source = src;
      incoming.dataset.fit = fit;
      incoming.dataset.position = position;
      incoming.style.setProperty("--outfit-bg-position", position);
      const incomingImages = Array.from(incoming.querySelectorAll<HTMLImageElement>("img"));
      incomingImages.forEach((image) => { image.src = src; });
      const reveal = async () => {
        await Promise.all(incomingImages.map(async (image) => {
          try { await image.decode(); } catch { /* The load fallback can still present a valid image. */ }
        }));
        if (incoming.dataset.source !== src) return;
        incoming.classList.add("is-ready");
        backgrounds.forEach((background, index) => background.classList.toggle("is-active", index === incomingIndex));
        activeBackground = incomingIndex;
      };
      void reveal();
    };

    const updateSelection = () => {
      const selectedSlot = modulo(Math.round(-angle / stepAngle), ringSize);
      const selectedPlane = planes.find((plane) => Number(plane.dataset.slot) === selectedSlot);
      if (!selectedPlane) return;
      const itemIndex = Number(selectedPlane.dataset.itemIndex) || 0;
      if (itemIndex === activeItemIndex) return;
      activeItemIndex = itemIndex;
      if (currentNumber) currentNumber.textContent = String(itemIndex + 1).padStart(2, "0");
      setBackground(
        selectedPlane.dataset.outfitBackground ?? "",
        selectedPlane.dataset.outfitBackgroundFit ?? "cover",
        selectedPlane.dataset.outfitBackgroundPosition ?? "center",
      );
    };

    const render = () => {
      if (!initialized) return;
      const bounds = carousel.getBoundingClientRect();
      const isMobile = bounds.width <= 760;
      const radiusX = Math.min(bounds.width * (isMobile ? 0.44 : 0.34), isMobile ? 310 : 540);
      const radiusZ = Math.min(Math.max(bounds.width * (isMobile ? 0.2 : 0.18), isMobile ? 115 : 150), isMobile ? 210 : 300);

      planes.forEach((plane) => {
        const slot = Number(plane.dataset.slot) || 0;
        const theta = normalizeAngle(slot * stepAngle + angle);
        const depth = Math.cos(theta);
        const side = Math.sin(theta);
        const frontness = (depth + 1) / 2;
        const isBack = depth < -0.04;
        const distanceFromFront = Math.abs(theta);
        const stepDistance = distanceFromFront / stepAngle;
        const visibleStep = Math.min(stepDistance, 2.85);
        const opacity = isBack
          ? 0.06 + Math.max(0, frontness) * 0.08
          : Math.max(0.1, 1 - visibleStep * 0.38);
        const scale = stepDistance <= 1
          ? 0.98 - stepDistance * 0.31
          : stepDistance <= 2
            ? 0.67 - (stepDistance - 1) * 0.18
            : Math.max(0.28, 0.49 - (stepDistance - 2) * 0.14);
        const x = side * radiusX;
        const y = Math.min(stepDistance, 3) * (isMobile ? 25 : 30) - 8;
        const z = depth * radiusZ;
        const selected = distanceFromFront < stepAngle * 0.45;
        plane.classList.toggle("is-lineup", !isBack && stepDistance <= 2.12);
        if (distanceFromFront < stepAngle * 3.15) {
          plane.querySelectorAll<HTMLImageElement>("img[data-src]").forEach((image) => {
            if (!image.getAttribute("src") && image.dataset.src) {
              image.src = image.dataset.src;
              void revealDecodedImage(image);
            }
          });
        }

        plane.style.setProperty("--outfit-x", `${x.toFixed(2)}px`);
        plane.style.setProperty("--outfit-y", `${y.toFixed(2)}px`);
        plane.style.setProperty("--outfit-z", `${z.toFixed(2)}px`);
        plane.style.setProperty("--outfit-scale", scale.toFixed(4));
        plane.style.setProperty("--outfit-opacity", opacity.toFixed(3));
        plane.style.zIndex = String(Math.round((depth + 1) * 100));
        plane.classList.toggle("is-behind", isBack);
        plane.classList.toggle("is-selected", selected);
        plane.setAttribute("aria-hidden", selected ? "false" : "true");
        plane.tabIndex = selected ? 0 : -1;
      });

      updateSelection();
    };

    const finishMotion = () => {
      frame = 0;
      motionStartedAt = 0;
      carousel.classList.remove("is-moving");
      carousel.removeAttribute("aria-busy");
      if (previousButton) previousButton.disabled = false;
      if (nextButton) nextButton.disabled = false;
      scheduleAutoplay();
    };

    const playMotion = (time: number) => {
      if (!motionStartedAt) motionStartedAt = time;
      const progress = Math.min(1, (time - motionStartedAt) / 920);
      const eased = progress < 0.5
        ? 16 * progress ** 5
        : 1 - ((-2 * progress + 2) ** 5) / 2;
      angle = motionStartAngle + (motionEndAngle - motionStartAngle) * eased;
      render();
      if (progress < 1) frame = requestAnimationFrame(playMotion);
      else {
        angle = motionEndAngle;
        targetAngle = motionEndAngle;
        render();
        finishMotion();
      }
    };

    const startMotion = (destination: number) => {
      if (frame) return;
      motionStartAngle = angle;
      motionEndAngle = destination;
      targetAngle = destination;
      carousel.classList.add("is-moving");
      carousel.setAttribute("aria-busy", "true");
      if (previousButton) previousButton.disabled = true;
      if (nextButton) nextButton.disabled = true;
      if (reducedMotion.matches) {
        angle = destination;
        render();
        finishMotion();
        return;
      }
      motionStartedAt = 0;
      frame = requestAnimationFrame(playMotion);
    };

    const moveBy = (direction: number) => {
      const destination = Math.round(targetAngle / stepAngle) * stepAngle + direction * stepAngle;
      startMotion(destination);
    };

    const moveManually = (direction: number) => {
      stopAutoplay();
      moveBy(direction);
    };

    previousButton?.addEventListener("click", () => moveManually(1));
    nextButton?.addEventListener("click", () => moveManually(-1));

    planes.forEach((plane) => {
      plane.addEventListener("click", () => {
        if (pointerMoved || frame) return;
        stopAutoplay();
        const slot = Number(plane.dataset.slot) || 0;
        const planeAngle = normalizeAngle(slot * stepAngle + angle);
        startMotion(angle - planeAngle);
      });
    });

    carousel.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      event.stopImmediatePropagation();
      moveManually(event.key === "ArrowLeft" ? 1 : -1);
    });

    carousel.addEventListener("selectstart", (event) => {
      event.preventDefault();
    });

    carousel.addEventListener("dragstart", (event) => {
      event.preventDefault();
    });

    stage.addEventListener("pointerdown", (event) => {
      if (frame || (event.pointerType === "mouse" && event.button !== 0)) return;
      event.preventDefault();
      stopAutoplay();
      dragging = true;
      pointerId = event.pointerId;
      pointerStartX = event.clientX;
      pointerStartAngle = angle;
      pointerMoved = false;
      motionStartedAt = 0;
      carousel.classList.remove("is-moving");
      targetAngle = angle;
      stage.setPointerCapture(pointerId);
      carousel.classList.add("is-dragging");
    });

    stage.addEventListener("pointermove", (event) => {
      if (!dragging || event.pointerId !== pointerId) return;
      const distance = event.clientX - pointerStartX;
      pointerMoved ||= Math.abs(distance) > 6;
      angle = pointerStartAngle + distance / Math.max(carousel.clientWidth * 0.34, 280);
      targetAngle = angle;
      render();
    });

    const releasePointer = (event: PointerEvent) => {
      if (!dragging || event.pointerId !== pointerId) return;
      dragging = false;
      carousel.classList.remove("is-dragging");
      if (stage.hasPointerCapture(pointerId)) stage.releasePointerCapture(pointerId);
      startMotion(Math.round(angle / stepAngle) * stepAngle);
      window.setTimeout(() => { pointerMoved = false; }, 0);
    };

    stage.addEventListener("pointerup", releasePointer);
    stage.addEventListener("pointercancel", releasePointer);
    window.addEventListener("resize", render, { passive: true });
    const revealDecodedImage = async (image: HTMLImageElement) => {
      try { await image.decode(); } catch { /* Keep the normal load result as a fallback. */ }
      image.classList.add("is-ready");
    };
    const initializeOutfits = () => {
      if (initialized) return;
      initialized = true;
      backgrounds.forEach((background) => {
        const images = Array.from(background.querySelectorAll<HTMLImageElement>("img[data-src]"));
        images.forEach((image) => {
          if (image.dataset.src) image.src = image.dataset.src;
        });
        void Promise.all(images.map(async (image) => {
          try { await image.decode(); } catch { /* Keep the normal load result as a fallback. */ }
        })).then(() => background.classList.add("is-ready"));
      });
      render();
      scheduleAutoplay();
    };

    window.addEventListener("bella:pagewillchange", (event) => {
      const detail = (event as CustomEvent<{ toHash?: string }>).detail;
      isOutfitPageActive = detail?.toHash === "#outfits";
      if (isOutfitPageActive) {
        initializeOutfits();
        scheduleAutoplay();
      } else stopAutoplay();
    });
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stopAutoplay();
      else scheduleAutoplay();
    });
    reducedMotion.addEventListener("change", scheduleAutoplay);
    if (isOutfitPageActive) {
      initializeOutfits();
      scheduleAutoplay();
    }
  }
</script>

<style>
  .outfit-page {
    --outfit-coral: #db7d74;
    color: #fff8f4;
    background: #111519;
    -webkit-user-select: none;
    user-select: none;
  }

  .outfit-backgrounds,
  .outfit-background,
  .outfit-background img,
  .outfit-wash,
  .outfit-rays { position: absolute; inset: 0; }

  .outfit-backgrounds { overflow: hidden; background: #162329; }
  .outfit-background {
    opacity: 0;
    scale: 1.055;
    transition: opacity 1.15s cubic-bezier(.22,.75,.22,1), scale 1.8s cubic-bezier(.22,.75,.22,1);
  }
  .outfit-background.is-active.is-ready { opacity: 1; scale: 1; }
  .outfit-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--outfit-bg-position, center);
    filter: saturate(.82) contrast(1.03) brightness(.68);
  }
  .outfit-background-blur { opacity: 0; }
  .outfit-background[data-fit="portrait"] .outfit-background-blur {
    opacity: 1;
    scale: 1.075;
    filter: blur(22px) saturate(.72) brightness(.52);
  }
  .outfit-background[data-fit="portrait"] .outfit-background-art {
    object-fit: contain;
    object-position: var(--outfit-bg-position, center top);
    filter: saturate(.78) contrast(1.02) brightness(.62);
    box-shadow: 0 0 54px 18px rgba(26,18,31,.42);
  }

  .outfit-wash {
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(8,17,21,.64), rgba(15,22,25,.12) 31%, rgba(16,20,22,.05) 62%, rgba(12,18,20,.42)),
      linear-gradient(180deg, rgba(8,10,13,.46), transparent 24%, transparent 64%, rgba(6,9,11,.78)),
      radial-gradient(ellipse at 50% 82%, rgba(240,139,119,.22), transparent 42%);
    pointer-events: none;
  }
  .outfit-wash::after {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(116deg, rgba(255,255,255,.018) 0 1px, transparent 1px 5px);
    content: "";
    mix-blend-mode: soft-light;
    opacity: .48;
  }

  .outfit-rays { z-index: 2; overflow: hidden; pointer-events: none; }
  .outfit-rays i { position: absolute; top: -22%; width: 1px; height: 90%; transform-origin: top; background: linear-gradient(rgba(255,237,218,.58), transparent 78%); box-shadow: 0 0 18px rgba(255,226,203,.35); opacity: .4; }
  .outfit-rays i:nth-child(1) { left: 33%; rotate: 18deg; }
  .outfit-rays i:nth-child(2) { left: 51%; rotate: -7deg; opacity: .24; }
  .outfit-rays i:nth-child(3) { left: 70%; rotate: -20deg; }
  .outfit-orbit-stars { position: absolute; z-index: 2; inset: 2%; overflow: hidden; border-radius: inherit; pointer-events: none; }
  .outfit-orbit-stars b {
    position: absolute;
    top: var(--star-y);
    left: var(--star-x);
    width: calc(3px + var(--star-index) * .028px);
    height: calc(3px + var(--star-index) * .028px);
    border-radius: 50%;
    background: rgba(255,247,238,.9);
    box-shadow: 0 0 9px 3px rgba(255,229,211,.52);
    opacity: calc(.18 + var(--star-index) * .018);
    animation: outfit-star-twinkle calc(4.8s + var(--star-index) * .17s) ease-in-out calc(var(--star-index) * -.29s) infinite;
  }
  .outfit-orbit-stars b:nth-child(4n) { width: 6px; height: 6px; border-radius: 0; background: #fff; clip-path: polygon(50% 0, 60% 39%, 100% 50%, 60% 61%, 50% 100%, 40% 61%, 0 50%, 40% 39%); box-shadow: none; filter: drop-shadow(0 0 7px rgba(255,226,206,.9)); }
  .outfit-orbit-stars b:nth-child(5n) { background: #f2c77d; box-shadow: 0 0 8px 2px rgba(242,199,125,.38); }
  .outfit-orbit-stars b:nth-child(7n) { background: #d9c7ff; box-shadow: 0 0 8px 2px rgba(189,159,255,.32); }
  @keyframes outfit-star-twinkle {
    0%, 100% { opacity: .3; transform: scale(.78); }
    42% { opacity: .96; transform: scale(1.18); }
    65% { opacity: .48; transform: scale(.92); }
  }
  .outfit-change-flash {
    position: absolute;
    z-index: 215;
    top: -20%;
    left: 50%;
    width: 2px;
    height: 140%;
    opacity: 0;
    background: #fff;
    box-shadow: 0 0 13px 3px rgba(255,255,255,.9), 0 0 42px 17px rgba(219,125,116,.55), 0 0 100px 34px rgba(113,202,208,.2);
    pointer-events: none;
    transform-origin: center;
  }

