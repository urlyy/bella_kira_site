---
const outfits = [
  {
    image: "/assets/clothes/毕方.png",
    background: "/assets/cloth_bg/毕方.png",
  },
];

// Keep enough planes on the ring to make its depth readable while the archive
// contains only one finished cutout. New outfits can be added to the array above.
const ringSize = Math.max(9, outfits.length);
const ringItems = Array.from({ length: ringSize }, (_, slot) => ({
  ...outfits[slot % outfits.length],
  slot,
  itemIndex: slot % outfits.length,
}));
---

<section class="page outfit-page" data-page-name="outfits" aria-label="服装展示">
  <div class="outfit-backgrounds" aria-hidden="true">
    <img class="outfit-background is-active" src={outfits[0].background} alt="" decoding="async" fetchpriority="high" draggable="false" />
    <img class="outfit-background" src={outfits[0].background} alt="" decoding="async" draggable="false" />
  </div>
  <div class="outfit-wash" aria-hidden="true"></div>
  <div class="outfit-rays" aria-hidden="true"><i></i><i></i><i></i></div>

  <header class="outfit-heading">
    <p>BELLA · OUTFIT ARCHIVE</p>
    <h1>服装展示</h1>
    <span>沿着光环，遇见每一种贝拉</span>
  </header>

  <div
    class="outfit-carousel"
    data-outfit-carousel
    data-ring-size={ringSize}
    tabindex="0"
    role="region"
    aria-roledescription="循环轮播"
    aria-label="贝拉服装轮播，可左右拖动或使用方向按钮"
  >
    <div class="outfit-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="outfit-stage" data-outfit-stage>
      {ringItems.map((item) => (
        <button
          class="outfit-plane"
          type="button"
          data-outfit-plane
          data-slot={item.slot}
          data-item-index={item.itemIndex}
          data-outfit-background={item.background}
          aria-label={`选择第 ${item.itemIndex + 1} 套服装`}
          tabindex="-1"
        >
          <span class="outfit-figure">
            <img
              src={item.image}
              alt=""
              width="681"
              height="2048"
              decoding="async"
              draggable="false"
            />
          </span>
          <span class="outfit-reflection" aria-hidden="true">
            <img src={item.image} alt="" width="681" height="2048" decoding="async" draggable="false" />
          </span>
        </button>
      ))}
    </div>

    <button class="outfit-arrow outfit-arrow-previous" type="button" data-outfit-previous aria-label="上一套服装">
      <i aria-hidden="true"></i><span>PREV</span>
    </button>
    <button class="outfit-arrow outfit-arrow-next" type="button" data-outfit-next aria-label="下一套服装">
      <span>NEXT</span><i aria-hidden="true"></i>
    </button>
  </div>

  <div class="outfit-current" aria-live="polite">
    <span data-outfit-number>01</span>
    <div><small>CURRENT OUTFIT</small></div>
    <i aria-hidden="true"></i>
  </div>

  <p class="outfit-instruction"><i aria-hidden="true"></i> 左右拖动 · 或使用两侧箭头</p>
  <span class="outfit-page-number" aria-hidden="true">04 / OUTFITS</span>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>("[data-outfit-carousel]");
  const stage = carousel?.querySelector<HTMLElement>("[data-outfit-stage]");
  const planes = Array.from(carousel?.querySelectorAll<HTMLButtonElement>("[data-outfit-plane]") ?? []);
  const previousButton = carousel?.querySelector<HTMLButtonElement>("[data-outfit-previous]");
  const nextButton = carousel?.querySelector<HTMLButtonElement>("[data-outfit-next]");
  const page = carousel?.closest<HTMLElement>(".outfit-page");
  const backgrounds = Array.from(page?.querySelectorAll<HTMLImageElement>(".outfit-background") ?? []);
  const currentNumber = page?.querySelector<HTMLElement>("[data-outfit-number]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (carousel && stage && planes.length) {
    const ringSize = Number(carousel.dataset.ringSize) || planes.length;
    const stepAngle = (Math.PI * 2) / ringSize;
    let angle = 0;
    let targetAngle = 0;
    let frame = 0;
    let motionStartedAt = 0;
    let motionStartAngle = 0;
    let motionEndAngle = 0;
    let activeItemIndex = -1;
    let activeBackground = 0;
    let dragging = false;
    let pointerId = -1;
    let pointerStartX = 0;
    let pointerStartAngle = 0;
    let pointerMoved = false;

    const normalizeAngle = (value: number) => Math.atan2(Math.sin(value), Math.cos(value));
    const modulo = (value: number, divisor: number) => ((value % divisor) + divisor) % divisor;

    const setBackground = (src: string) => {
      const current = backgrounds[activeBackground];
      if (!current || current.dataset.source === src || current.getAttribute("src") === src) {
        if (current) current.dataset.source = src;
        return;
      }
      const incomingIndex = activeBackground === 0 ? 1 : 0;
      const incoming = backgrounds[incomingIndex];
      if (!incoming) return;
      incoming.classList.remove("is-ready");
      incoming.src = src;
      incoming.dataset.source = src;
      const reveal = async () => {
        try { await incoming.decode(); } catch { /* The load fallback can still present a valid image. */ }
        if (incoming.dataset.source !== src) return;
        incoming.classList.add("is-ready");
        backgrounds.forEach((background, index) => background.classList.toggle("is-active", index === incomingIndex));
        activeBackground = incomingIndex;
      };
      void reveal();
    };

    const updateSelection = () => {
      const selectedSlot = modulo(Math.round(-angle / stepAngle), ringSize);
      const selectedPlane = planes.find((plane) => Number(plane.dataset.slot) === selectedSlot);
      if (!selectedPlane) return;
      const itemIndex = Number(selectedPlane.dataset.itemIndex) || 0;
      if (itemIndex === activeItemIndex) return;
      activeItemIndex = itemIndex;
      if (currentNumber) currentNumber.textContent = String(itemIndex + 1).padStart(2, "0");
      setBackground(selectedPlane.dataset.outfitBackground ?? "");
    };

    const render = () => {
      const bounds = carousel.getBoundingClientRect();
      const radiusX = Math.min(bounds.width * 0.43, 690);
      const radiusZ = Math.min(Math.max(bounds.width * 0.17, 130), 270);

      planes.forEach((plane) => {
        const slot = Number(plane.dataset.slot) || 0;
        const theta = normalizeAngle(slot * stepAngle + angle);
        const depth = Math.cos(theta);
        const side = Math.sin(theta);
        const frontness = (depth + 1) / 2;
        const isBack = depth < -0.04;
        const distanceFromFront = Math.abs(theta);
        const opacity = isBack
          ? 0.12 + Math.max(0, frontness) * 0.13
          : Math.max(0.18, 1 - Math.pow(distanceFromFront / (Math.PI * 0.58), 1.18));
        const scale = 0.42 + frontness * 0.42;
        const x = side * radiusX;
        const y = (1 - frontness) * 54 - 8;
        const z = depth * radiusZ;
        const selected = distanceFromFront < stepAngle * 0.45;

        plane.style.setProperty("--outfit-x", `${x.toFixed(2)}px`);
        plane.style.setProperty("--outfit-y", `${y.toFixed(2)}px`);
        plane.style.setProperty("--outfit-z", `${z.toFixed(2)}px`);
        plane.style.setProperty("--outfit-scale", scale.toFixed(4));
        plane.style.setProperty("--outfit-opacity", opacity.toFixed(3));
        plane.style.zIndex = String(Math.round((depth + 1) * 100));
        plane.classList.toggle("is-behind", isBack);
        plane.classList.toggle("is-selected", selected);
        plane.setAttribute("aria-hidden", selected ? "false" : "true");
        plane.tabIndex = selected ? 0 : -1;
      });

      updateSelection();
    };

    const finishMotion = () => {
      frame = 0;
      motionStartedAt = 0;
      carousel.classList.remove("is-moving");
      carousel.removeAttribute("aria-busy");
      if (previousButton) previousButton.disabled = false;
      if (nextButton) nextButton.disabled = false;
    };

    const playMotion = (time: number) => {
      if (!motionStartedAt) motionStartedAt = time;
      const progress = Math.min(1, (time - motionStartedAt) / 920);
      const eased = progress < 0.5
        ? 16 * progress ** 5
        : 1 - ((-2 * progress + 2) ** 5) / 2;
      angle = motionStartAngle + (motionEndAngle - motionStartAngle) * eased;
      render();
      if (progress < 1) frame = requestAnimationFrame(playMotion);
      else {
        angle = motionEndAngle;
        targetAngle = motionEndAngle;
        render();
        finishMotion();
      }
    };

    const startMotion = (destination: number) => {
      if (frame) return;
      motionStartAngle = angle;
      motionEndAngle = destination;
      targetAngle = destination;
      carousel.classList.add("is-moving");
      carousel.setAttribute("aria-busy", "true");
      if (previousButton) previousButton.disabled = true;
      if (nextButton) nextButton.disabled = true;
      if (reducedMotion.matches) {
        angle = destination;
        render();
        finishMotion();
        return;
      }
      motionStartedAt = 0;
      frame = requestAnimationFrame(playMotion);
    };

    const moveBy = (direction: number) => {
      const destination = Math.round(targetAngle / stepAngle) * stepAngle + direction * stepAngle;
      startMotion(destination);
    };

    previousButton?.addEventListener("click", () => moveBy(1));
    nextButton?.addEventListener("click", () => moveBy(-1));

    planes.forEach((plane) => {
      plane.addEventListener("click", () => {
        if (pointerMoved || frame) return;
        const slot = Number(plane.dataset.slot) || 0;
        const planeAngle = normalizeAngle(slot * stepAngle + angle);
        startMotion(angle - planeAngle);
      });
    });

    carousel.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      event.stopImmediatePropagation();
      moveBy(event.key === "ArrowLeft" ? 1 : -1);
    });

    stage.addEventListener("pointerdown", (event) => {
      if (frame || (event.pointerType === "mouse" && event.button !== 0)) return;
      dragging = true;
      pointerId = event.pointerId;
      pointerStartX = event.clientX;
      pointerStartAngle = angle;
      pointerMoved = false;
      motionStartedAt = 0;
      carousel.classList.remove("is-moving");
      targetAngle = angle;
      stage.setPointerCapture(pointerId);
      carousel.classList.add("is-dragging");
    });

    stage.addEventListener("pointermove", (event) => {
      if (!dragging || event.pointerId !== pointerId) return;
      const distance = event.clientX - pointerStartX;
      pointerMoved ||= Math.abs(distance) > 6;
      angle = pointerStartAngle + distance / Math.max(carousel.clientWidth * 0.34, 280);
      targetAngle = angle;
      render();
    });

    const releasePointer = (event: PointerEvent) => {
      if (!dragging || event.pointerId !== pointerId) return;
      dragging = false;
      carousel.classList.remove("is-dragging");
      if (stage.hasPointerCapture(pointerId)) stage.releasePointerCapture(pointerId);
      startMotion(Math.round(angle / stepAngle) * stepAngle);
      window.setTimeout(() => { pointerMoved = false; }, 0);
    };

    stage.addEventListener("pointerup", releasePointer);
    stage.addEventListener("pointercancel", releasePointer);
    window.addEventListener("resize", render, { passive: true });
    const revealDecodedImage = async (image: HTMLImageElement) => {
      try { await image.decode(); } catch { /* Keep the normal load result as a fallback. */ }
      image.classList.add("is-ready");
    };
    backgrounds.forEach((background) => {
      background.dataset.source = background.getAttribute("src") ?? "";
      void revealDecodedImage(background);
    });
    carousel.querySelectorAll<HTMLImageElement>(".outfit-figure img, .outfit-reflection img").forEach((image) => {
      void revealDecodedImage(image);
    });
    render();
  }
</script>

<style>
  .outfit-page {
    --outfit-coral: #db7d74;
    color: #fff8f4;
    background: #111519;
  }

  .outfit-backgrounds,
  .outfit-background,
  .outfit-wash,
  .outfit-rays { position: absolute; inset: 0; }

  .outfit-backgrounds { overflow: hidden; background: #162329; }
  .outfit-background {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    scale: 1.055;
    filter: saturate(.82) contrast(1.03) brightness(.68);
    transition: opacity 1.15s cubic-bezier(.22,.75,.22,1), scale 1.8s cubic-bezier(.22,.75,.22,1);
  }
  .outfit-background.is-active.is-ready { opacity: 1; scale: 1; }

  .outfit-wash {
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(8,17,21,.64), rgba(15,22,25,.12) 31%, rgba(16,20,22,.05) 62%, rgba(12,18,20,.42)),
      linear-gradient(180deg, rgba(8,10,13,.46), transparent 24%, transparent 64%, rgba(6,9,11,.78)),
      radial-gradient(ellipse at 50% 82%, rgba(240,139,119,.22), transparent 42%);
    pointer-events: none;
  }
  .outfit-wash::after {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(116deg, rgba(255,255,255,.018) 0 1px, transparent 1px 5px);
    content: "";
    mix-blend-mode: soft-light;
    opacity: .48;
  }

  .outfit-rays { z-index: 2; overflow: hidden; pointer-events: none; }
  .outfit-rays i { position: absolute; top: -22%; width: 1px; height: 90%; transform-origin: top; background: linear-gradient(rgba(255,237,218,.58), transparent 78%); box-shadow: 0 0 18px rgba(255,226,203,.35); opacity: .4; }
  .outfit-rays i:nth-child(1) { left: 33%; rotate: 18deg; }
  .outfit-rays i:nth-child(2) { left: 51%; rotate: -7deg; opacity: .24; }
  .outfit-rays i:nth-child(3) { left: 70%; rotate: -20deg; }

  .outfit-heading { position: absolute; z-index: 220; top: clamp(102px, 14vh, 148px); left: clamp(24px, 5.7vw, 92px); pointer-events: none; }
  .outfit-heading p { margin: 0 0 8px; color: rgba(255,231,217,.72); font: 600 9px/1 system-ui,sans-serif; letter-spacing: .31em; }
  .outfit-heading h1 { margin: 0; font-size: clamp(30px, 3.8vw, 57px); font-weight: 400; line-height: 1; letter-spacing: .13em; text-shadow: 0 4px 28px rgba(0,0,0,.4); }
  .outfit-heading span { display: block; margin-top: 12px; color: rgba(255,244,238,.66); font-size: 11px; letter-spacing: .16em; }

  .outfit-carousel {
    position: absolute;
    z-index: 5;
    inset: clamp(122px, 15vh, 158px) 0 82px;
    outline: none;
    perspective: 1200px;
    perspective-origin: 50% 47%;
    touch-action: pan-y;
    user-select: none;
  }
  .outfit-carousel:focus-visible::after { position: absolute; inset: 4px 18px; border: 1px solid rgba(255,230,216,.48); border-radius: 3px; content: ""; pointer-events: none; }

  .outfit-stage { position: absolute; inset: 0; cursor: grab; transform-style: preserve-3d; }
  .outfit-carousel.is-dragging .outfit-stage { cursor: grabbing; }

  .outfit-orbit { position: absolute; z-index: 0; left: 50%; bottom: -3%; width: min(86vw, 1250px); aspect-ratio: 3.7 / 1; translate: -50% 0; border: 1px solid rgba(255,222,202,.28); border-radius: 50%; transform: rotateX(64deg); box-shadow: inset 0 0 55px rgba(229,112,99,.12), 0 0 50px rgba(255,194,169,.12); }
  .outfit-orbit::before,
  .outfit-orbit::after { position: absolute; border: 1px solid rgba(255,228,211,.16); border-radius: inherit; content: ""; }
  .outfit-orbit::before { inset: 13%; }
  .outfit-orbit::after { inset: 28%; background: radial-gradient(ellipse, rgba(251,164,139,.12), transparent 68%); box-shadow: 0 0 80px rgba(236,130,109,.1); }
  .outfit-orbit i { position: absolute; z-index: 1; width: 5px; height: 5px; border-radius: 50%; background: #ffe2cf; box-shadow: 0 0 12px 4px rgba(246,158,130,.55); }
  .outfit-orbit i:nth-child(1) { top: 16%; left: 18%; }
  .outfit-orbit i:nth-child(2) { right: 10%; bottom: 39%; }
  .outfit-orbit i:nth-child(3) { bottom: 7%; left: 43%; }

  .outfit-plane {
    --outfit-x: 0px;
    --outfit-y: 0px;
    --outfit-z: 0px;
    --outfit-scale: 1;
    --outfit-opacity: 1;
    position: absolute;
    top: 0;
    left: 50%;
    width: clamp(190px, 20vw, 318px);
    height: calc(100% - 5px);
    margin: 0;
    padding: 0;
    border: 0;
    outline: none;
    background: none;
    opacity: var(--outfit-opacity);
    transform: translate3d(calc(-50% + var(--outfit-x)), var(--outfit-y), var(--outfit-z)) scale(var(--outfit-scale));
    transform-origin: 50% 86%;
    transform-style: preserve-3d;
    will-change: transform, opacity;
    cursor: pointer;
  }
  .outfit-figure { position: absolute; inset: 0; display: flex; align-items: flex-end; justify-content: center; transform-style: preserve-3d; }
  .outfit-figure img { display: block; width: auto; height: min(73vh, 100%); max-width: 100%; object-fit: contain; object-position: center bottom; opacity: 0; transform: scaleX(1); transform-origin: center; filter: drop-shadow(0 19px 21px rgba(0,0,0,.48)) drop-shadow(0 0 14px rgba(255,188,159,.12)); transition: filter .42s ease, opacity .38s ease; }
  .outfit-figure img.is-ready { opacity: 1; }
  .outfit-plane.is-behind .outfit-figure img { transform: scaleX(-1); filter: brightness(0) saturate(0) drop-shadow(0 18px 18px rgba(0,0,0,.72)); }
  .outfit-plane.is-selected .outfit-figure img { filter: drop-shadow(0 22px 25px rgba(0,0,0,.5)) drop-shadow(0 0 21px rgba(255,207,179,.34)); }
  .outfit-plane:focus-visible .outfit-figure::after { position: absolute; inset: 7% 8% 3%; border: 1px solid rgba(255,225,207,.62); border-radius: 50%; content: ""; box-shadow: 0 0 24px rgba(219,125,116,.25); }

  .outfit-reflection { position: absolute; z-index: -1; top: 88%; left: 50%; width: 100%; height: 32%; translate: -50% 0; overflow: hidden; opacity: .18; transform: scaleY(-1); transform-origin: top; filter: blur(1px); mask-image: linear-gradient(to bottom, rgba(0,0,0,.72), transparent 80%); pointer-events: none; }
  .outfit-reflection img { display: block; width: auto; height: min(73vh, 313%); max-width: 100%; margin: 0 auto; object-fit: contain; object-position: center bottom; opacity: 0; transform: translateY(-68%); transition: opacity .38s ease; }
  .outfit-reflection img.is-ready { opacity: 1; }
  .outfit-plane.is-behind .outfit-reflection { opacity: 0; }

  .outfit-arrow { position: absolute; z-index: 230; top: 52%; display: flex; min-width: clamp(118px, 12vw, 178px); min-height: 96px; align-items: center; justify-content: center; gap: 13px; padding: 28px 18px; border: 0; color: rgba(255,242,233,.76); background: none; font: 600 11px/1 system-ui,sans-serif; letter-spacing: .24em; cursor: pointer; translate: 0 -50%; transition: color .25s ease, opacity .25s ease, transform .25s ease; }
  .outfit-arrow-previous { left: clamp(5px, 2vw, 28px); }
  .outfit-arrow-next { right: clamp(5px, 2vw, 28px); }
  .outfit-arrow i { position: relative; width: clamp(38px, 5vw, 76px); height: 1px; background: currentColor; box-shadow: 0 0 10px currentColor; }
  .outfit-arrow i::after { position: absolute; top: -3px; width: 7px; height: 7px; border-top: 1px solid currentColor; border-left: 1px solid currentColor; content: ""; }
  .outfit-arrow-previous i::after { left: 0; rotate: -45deg; }
  .outfit-arrow-next i::after { right: 0; rotate: 135deg; }
  .outfit-arrow:hover,
  .outfit-arrow:focus-visible { color: #fff; transform: translateX(var(--arrow-shift, 0)); outline: none; }
  .outfit-arrow-previous:hover,
  .outfit-arrow-previous:focus-visible { --arrow-shift: -5px; }
  .outfit-arrow-next:hover,
  .outfit-arrow-next:focus-visible { --arrow-shift: 5px; }
  .outfit-carousel.is-moving .outfit-arrow { opacity: .5; pointer-events: none; }

  .outfit-current { position: absolute; z-index: 240; left: 50%; bottom: clamp(24px, 4.5vh, 50px); display: flex; align-items: center; gap: 14px; translate: -50% 0; text-shadow: 0 2px 15px rgba(0,0,0,.68); pointer-events: none; }
  .outfit-current > span { color: rgba(255,226,210,.7); font: 300 31px/1 Georgia,serif; }
  .outfit-current > div { display: grid; min-width: 110px; }
  .outfit-current small { color: rgba(255,231,218,.52); font: 600 7px/1 system-ui,sans-serif; letter-spacing: .24em; }
  .outfit-current > i { width: 52px; height: 1px; background: linear-gradient(90deg, rgba(255,225,208,.7), transparent); }

  .outfit-instruction { position: absolute; z-index: 230; right: clamp(26px, 5vw, 78px); bottom: 30px; display: flex; align-items: center; gap: 8px; margin: 0; color: rgba(255,239,230,.48); font: 400 9px/1 system-ui,sans-serif; letter-spacing: .16em; }
  .outfit-instruction i { width: 4px; height: 4px; border-radius: 50%; background: var(--outfit-coral); box-shadow: 0 0 10px var(--outfit-coral); }
  .outfit-page-number { position: absolute; z-index: 230; bottom: 29px; left: clamp(24px, 5.7vw, 92px); color: rgba(255,235,223,.44); font: 600 8px/1 system-ui,sans-serif; letter-spacing: .25em; }

  @media (max-width: 760px) {
    .outfit-heading { top: calc(88px + env(safe-area-inset-top, 0px)); left: 18px; }
    .outfit-heading h1 { font-size: 32px; }
    .outfit-heading span { font-size: 9px; }
    .outfit-carousel { inset: calc(132px + env(safe-area-inset-top, 0px)) 0 calc(74px + env(safe-area-inset-bottom, 0px)); perspective: 850px; }
    .outfit-plane { width: clamp(148px, 44vw, 210px); }
    .outfit-figure img { height: min(64vh, 100%); }
    .outfit-arrow { top: 55%; gap: 0; min-width: 58px; min-height: 58px; width: 58px; height: 58px; padding: 10px; border: 1px solid rgba(255,230,215,.25); border-radius: 50%; justify-content: center; background: rgba(12,18,20,.34); }
    .outfit-arrow span { display: none; }
    .outfit-arrow i { width: 19px; }
    .outfit-arrow-previous { left: 10px; }
    .outfit-arrow-next { right: 10px; }
    .outfit-current { bottom: calc(29px + env(safe-area-inset-bottom, 0px)); }
    .outfit-current > i { display: none; }
    .outfit-instruction { display: none; }
    .outfit-page-number { bottom: calc(15px + env(safe-area-inset-bottom, 0px)); left: 16px; }
    .outfit-orbit { width: 116vw; bottom: 3%; }
  }

  @media (max-height: 680px) and (min-width: 761px) {
    .outfit-heading { top: 104px; }
    .outfit-heading span { display: none; }
    .outfit-carousel { inset: 106px 0 66px; }
    .outfit-current { bottom: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .outfit-background,
    .outfit-figure img,
    .outfit-arrow { transition: none; }
  }
</style>
