<div class="site-preloader" data-site-preloader role="status" aria-live="polite" aria-label="正在准备贝拉kira应援站">
  <div class="preloader-stars" aria-hidden="true">
    {Array.from({ length: 26 }, (_, index) => (
      <i style={`--star:${index};--x:${(index * 37) % 97}%;--y:${(index * 61) % 89}%;--delay:${(index % 9) * -0.24}s`}></i>
    ))}
  </div>
  <div class="preloader-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="preloader-card">
    <div class="preloader-mark" aria-hidden="true">
      <span></span>
      <img src="/assets/optimized/beijixing.webp" alt="" draggable="false" />
    </div>
    <p>BELLA KIRA · STAGE PREPARATION</p>
    <h1>正在点亮贝拉的舞台</h1>
    <span class="preloader-message" data-preloader-message>循着星光，准备首屏影像</span>
    <div
      class="preloader-progress"
      data-preloader-progress
      role="progressbar"
      aria-label="网站资源加载进度"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <div><i data-preloader-bar></i><b aria-hidden="true"></b></div>
      <strong data-preloader-percent>00%</strong>
    </div>
    <small>首页视频 · 服装档案 · 字体</small>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    try {
      if (sessionStorage.getItem("bella-site-preloaded-v1") === "1") {
        root.classList.add("is-site-ready");
        return;
      }
    } catch {}
    root.classList.add("is-site-preloading");
  })();
</script>

<script>
  const preloader = document.querySelector<HTMLElement>("[data-site-preloader]");
  const progress = preloader?.querySelector<HTMLElement>("[data-preloader-progress]");
  const progressBar = preloader?.querySelector<HTMLElement>("[data-preloader-bar]");
  const percent = preloader?.querySelector<HTMLElement>("[data-preloader-percent]");
  const message = preloader?.querySelector<HTMLElement>("[data-preloader-message]");
  const root = document.documentElement;

  if (preloader && root.classList.contains("is-site-preloading")) {
    const startedAt = performance.now();
    const video = document.querySelector<HTMLVideoElement>(".hero-video");
    const outfitSources = Array.from(document.querySelectorAll<HTMLImageElement>(".outfit-page img[data-src]"))
      .map((image) => image.dataset.src)
      .filter((src): src is string => Boolean(src));
    const outfitBackgroundSources = Array.from(document.querySelectorAll<HTMLElement>(".outfit-page [data-outfit-background]"))
      .map((item) => item.dataset.outfitBackground)
      .filter((src): src is string => Boolean(src));
    const imageSources = [...new Set([...outfitSources, ...outfitBackgroundSources])];
    const taskCount = imageSources.length + 2;
    let completedTasks = 0;
    let displayedProgress = 0;
    let targetProgress = 0;
    let progressFrame = 0;

    const renderProgress = () => {
      displayedProgress += (targetProgress - displayedProgress) * 0.14;
      if (targetProgress - displayedProgress < 0.12) displayedProgress = targetProgress;
      const value = Math.max(0, Math.min(100, displayedProgress));
      if (progressBar) progressBar.style.width = `${value}%`;
      progress?.style.setProperty("--progress", `${value}%`);
      if (percent) percent.textContent = `${String(Math.round(value)).padStart(2, "0")}%`;
      progress?.setAttribute("aria-valuenow", String(Math.round(value)));
      if (displayedProgress < targetProgress) progressFrame = requestAnimationFrame(renderProgress);
      else progressFrame = 0;
    };

    const updateProgress = () => {
      targetProgress = Math.min(96, completedTasks / taskCount * 96);
      if (!progressFrame) progressFrame = requestAnimationFrame(renderProgress);
    };

    const completeTask = () => {
      completedTasks += 1;
      updateProgress();
    };

    const preloadImage = (src: string) => new Promise<void>((resolve) => {
      const image = new Image();
      const finish = () => resolve();
      image.addEventListener("load", finish, { once: true });
      image.addEventListener("error", finish, { once: true });
      image.decoding = "async";
      image.src = src;
      if (image.complete) finish();
    }).finally(completeTask);

    const preloadFont = document.fonts
      ? document.fonts.load('1em "LXGW WenKai Mono Lite"').then(() => undefined, () => undefined).finally(completeTask)
      : Promise.resolve().finally(completeTask);

    const preloadVideo = new Promise<void>((resolve) => {
      if (!video || video.readyState >= HTMLMediaElement.HAVE_FUTURE_DATA) {
        resolve();
        return;
      }
      const finish = () => {
        video.removeEventListener("canplay", finish);
        video.removeEventListener("error", finish);
        resolve();
      };
      video.addEventListener("canplay", finish, { once: true });
      video.addEventListener("error", finish, { once: true });
      video.load();
    }).finally(completeTask);

    const imageTasks = imageSources.map(preloadImage);
    if (message) message.textContent = "收拢服装档案与舞台光影";

    const timeout = new Promise<void>((resolve) => window.setTimeout(resolve, 20000));
    const allAssets = Promise.allSettled([...imageTasks, preloadFont, preloadVideo]).then(() => undefined);

    void Promise.race([allAssets, timeout]).then(async () => {
      const remainingDelay = Math.max(0, 900 - (performance.now() - startedAt));
      if (remainingDelay) await new Promise((resolve) => window.setTimeout(resolve, remainingDelay));
      targetProgress = 100;
      if (message) message.textContent = "星光就位，欢迎来到贝拉的舞台";
      if (!progressFrame) progressFrame = requestAnimationFrame(renderProgress);
      await new Promise((resolve) => window.setTimeout(resolve, 420));
      preloader.classList.add("is-complete");
      root.classList.remove("is-site-preloading");
      root.classList.add("is-site-ready");
      try {
        sessionStorage.setItem("bella-site-preloaded-v1", "1");
      } catch {}
      window.dispatchEvent(new CustomEvent("bella:preloadcomplete"));
      if (window.location.hash === "" || window.location.hash === "#home") void video?.play().catch(() => undefined);
      window.setTimeout(() => preloader.remove(), 760);
    });
  }
</script>

<style>
  :global(html.is-site-ready) .site-preloader { display: none; }
  .site-preloader {
    position: fixed;
    z-index: 1000;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: #fff8f2;
    background:
      radial-gradient(circle at 50% 58%, rgba(219,125,116,.16), transparent 26%),
      radial-gradient(circle at 18% 18%, rgba(132,91,166,.2), transparent 28%),
      linear-gradient(145deg, #090712, #171022 52%, #0b0913);
    opacity: 1;
    transition: opacity 700ms ease, visibility 700ms step-end;
  }
  .site-preloader.is-complete { visibility: hidden; opacity: 0; }
  .preloader-stars { position: absolute; inset: 0; }
  .preloader-stars i {
    position: absolute;
    top: var(--y);
    left: var(--x);
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #fff4bd;
    box-shadow: 0 0 9px #fff4bd;
    opacity: .28;
    animation: preloader-twinkle 2.4s var(--delay) ease-in-out infinite alternate;
  }
  .preloader-orbit { position: absolute; width: min(72vw, 48rem); aspect-ratio: 1; border: 1px solid rgba(240,207,170,.1); border-radius: 50%; transform: rotateX(68deg) rotateZ(-13deg); }
  .preloader-orbit::before, .preloader-orbit::after { position: absolute; inset: 12%; border: 1px solid rgba(219,125,116,.1); border-radius: inherit; content: ""; }
  .preloader-orbit::after { inset: 27%; border-color: rgba(197,155,214,.13); }
  .preloader-orbit i { position: absolute; top: 49%; left: 49%; width: 5px; height: 5px; border-radius: 50%; background: #db7d74; box-shadow: 0 0 14px #db7d74; animation: preloader-orbit 5.5s linear infinite; }
  .preloader-card { position: relative; z-index: 1; display: grid; width: min(88vw, 32rem); justify-items: center; text-align: center; }
  .preloader-mark { position: relative; display: grid; width: 6.5rem; height: 6.5rem; margin-bottom: 1.2rem; place-items: center; }
  .preloader-mark::before, .preloader-mark::after, .preloader-mark span { position: absolute; inset: 0; border: 1px solid rgba(255,244,189,.24); border-radius: 50%; content: ""; animation: preloader-ring 4.8s linear infinite; }
  .preloader-mark::after { inset: .7rem; border-color: rgba(219,125,116,.38); animation-direction: reverse; animation-duration: 3.8s; }
  .preloader-mark span { inset: 1.4rem; border-style: dashed; border-color: rgba(208,169,221,.34); animation-duration: 6s; }
  .preloader-mark img { position: relative; width: 3rem; height: 3.6rem; object-fit: contain; filter: drop-shadow(0 0 14px rgba(255,244,189,.32)); animation: preloader-float 2.2s ease-in-out infinite alternate; }
  .preloader-card > p { margin: 0; color: #db9e98; font: 600 .62rem/1.4 sans-serif; letter-spacing: .28em; }
  .preloader-card h1 { margin: .75rem 0 .55rem; font-size: clamp(1.8rem, 4vw, 2.7rem); font-weight: 400; letter-spacing: .12em; }
  .preloader-message { min-height: 1.5rem; color: rgba(244,235,242,.62); font-size: .78rem; letter-spacing: .09em; }
  .preloader-progress { display: grid; grid-template-columns: minmax(0,1fr) 3rem; width: 100%; align-items: center; gap: 1rem; margin-top: 1.6rem; }
  .preloader-progress > div { position: relative; height: 3px; overflow: visible; background: rgba(255,255,255,.11); }
  .preloader-progress > div::before { position: absolute; inset: -7px 0; border-top: 1px solid rgba(255,255,255,.035); border-bottom: 1px solid rgba(255,255,255,.035); content: ""; }
  .preloader-progress i { position: absolute; inset: 0 auto 0 0; width: 0; background: linear-gradient(90deg, #8e69a7, #db7d74 72%, #fff4bd); box-shadow: 0 0 12px rgba(219,125,116,.58); }
  .preloader-progress b { position: absolute; top: 50%; left: var(--progress, 0%); width: 8px; height: 8px; border-radius: 50%; background: #fff4bd; box-shadow: 0 0 15px #fff4bd; translate: -50% -50%; }
  .preloader-progress strong { color: #fff4bd; font: 400 .78rem/1 sans-serif; letter-spacing: .1em; }
  .preloader-card > small { margin-top: .8rem; color: rgba(231,211,235,.35); font: 500 .54rem/1.5 sans-serif; letter-spacing: .22em; }
  @keyframes preloader-twinkle { to { opacity: .9; transform: scale(1.7); } }
  @keyframes preloader-ring { to { rotate: 360deg; } }
  @keyframes preloader-float { to { translate: 0 -.35rem; } }
  @keyframes preloader-orbit { to { transform: rotate(360deg) translateX(50%) rotate(-360deg); } }
  @media (max-width: 600px) { .preloader-orbit { width: 125vw; } .preloader-card { width: min(84vw, 26rem); } .preloader-card h1 { font-size: 1.7rem; } }
  @media (prefers-reduced-motion: reduce) { .preloader-stars i, .preloader-orbit i, .preloader-mark::before, .preloader-mark::after, .preloader-mark span, .preloader-mark img { animation: none; } .site-preloader { transition-duration: 180ms; } }
</style>
