---
import { visibleInteractiveExperiences as experiences } from "../../content/interactive-experiences";
import InteractiveHeadModel from "./InteractiveHeadModel.astro";
import "../../pages/games/games.css";
---

<section
	class="page interactive-space-page"
	data-page-name="space"
	aria-label="互动空间"
>
	<div
		class="page-visual page-scroll-surface games-page interactive-space-visual"
	>
		<div class="games-atmosphere" aria-hidden="true"></div>
		<section class="games-intro" aria-labelledby="interactive-space-title">
			<p class="games-kicker">STARRY DREAMS · INTERACTIVE SPACE</p>
			<div class="games-title-row">
				<h1 id="interactive-space-title">互动空间</h1>
				<InteractiveHeadModel />
				<span class="games-count"
					><b>{String(experiences.length).padStart(2, "0")}</b> 项体验</span
				>
			</div>
		</section>
		<section class="game-grid" aria-label="互动体验列表">
			{
				experiences.map((game, index) => (
					<a
						class:list={[
							"game-card",
							`tone-${game.tone}`,
							{ featured: index === 0 },
						]}
						href={`/games/${game.slug}/`}
					>
						<span class="game-card-number">
							{String(index + 1).padStart(2, "0")}
						</span>
						<span class="game-card-mark" aria-hidden="true">
							{game.mark}
						</span>
						<span class="game-card-copy">
							<>
								<small>{game.eyebrow}</small>
								<strong>{game.title}</strong>
								<span>{game.description}</span>
							</>
						</span>
						<span class="game-card-action">
							{"action" in game ? game.action : "开始游戏"}{" "}
							<i aria-hidden="true">↗</i>
						</span>
					</a>
				))
			}
		</section>
	</div>
</section>
