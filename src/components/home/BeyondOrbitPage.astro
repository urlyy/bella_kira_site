---

<section class="page corner-page" data-page-name="corner" aria-label="枝江路标">
	<div class="page-visual corner-visual mobile-page-scroll-surface">
		<div class="corner-map" aria-hidden="true">
			<svg viewBox="0 0 1440 900" preserveAspectRatio="none">
				<path
					class="route-shadow"
					d="M -80 735 C 160 690, 220 590, 430 610 S 755 760, 920 620 S 1190 440, 1510 505"
				></path>
				<path
					class="route-line"
					d="M -80 735 C 160 690, 220 590, 430 610 S 755 760, 920 620 S 1190 440, 1510 505"
				></path>
				<circle cx="210" cy="660" r="7"></circle>
				<circle cx="520" cy="636" r="7"></circle>
				<circle cx="875" cy="650" r="7"></circle>
				<circle cx="1175" cy="515" r="7"></circle>
			</svg>
		</div>
		<header class="corner-heading">
			<p>ZHIJIANG · LINKS & PLACES</p><h1>枝江路标</h1>
		</header>
		<section class="platform" aria-labelledby="idols-title">
			<div class="section-title">
				<b>01</b><h2 id="idols-title">枝江虚拟偶像</h2><small
					>OFFICIAL PROFILES</small
				>
			</div>
			<div class="signs">
				{
					idols.map((idol, i) => (
						<a
							class="idol-sign"
							href={idol.href}
							target="_blank"
							rel="noreferrer"
							style={`--light:${idol.color};--i:${i}`}
						>
							<>
								<img
									data-src={idol.avatar}
									alt=""
									width="480"
									height="480"
									loading="lazy"
									draggable="false"
									decoding="async"
								/>
								<small>{idol.latin}</small>
								<strong>{idol.name}</strong>
								<span>{idol.group}</span>
								<em>前往主页 ↗</em>
							</>
						</a>
					))
				}
			</div>
		</section>
		<section class="stops" aria-labelledby="stops-title">
			<div class="section-title">
				<b>02</b><h2 id="stops-title">站外资源</h2><small
					>LINKS & RESOURCES</small
				>
			</div>
			<div class="stop-list">
				{
					links.map((link, i) => (
						<a
							class="stop"
							href={link.href}
							target="_blank"
							rel="noreferrer"
						>
							<>
								<b>{String(i + 1).padStart(2, "0")}</b>
								<div>
									<>
										<small>{link.code}</small>
										<strong>{link.name}</strong>
										{/* <span>{link.note}</span> */}
									</>
								</div>
								<em>向此处 ↗</em>
							</>
						</a>
					))
				}
			</div>
		</section>
	</div>
</section>
<script>
	const initializeCornerImages = () => {
		document
			.querySelectorAll<HTMLImageElement>(".corner-page img[data-src]")
			.forEach((image) => {
				if (image.dataset.src) image.src = image.dataset.src;
				delete image.dataset.src;
			});
	};
	window.addEventListener("bella:pagewillchange", (event) => {
		if (
			(event as CustomEvent<{ toHash?: string }>).detail?.toHash ===
			"#corner"
		)
			initializeCornerImages();
	});
	if (window.location.hash === "#corner") initializeCornerImages();
</script>
<style>
	.corner-visual {
		overflow: hidden;
		background:
			radial-gradient(circle at 82% 16%, #9e6c9b29, transparent 28%),
			linear-gradient(145deg, #181324, #100e1a 58%, #0a0a11);
		color: #f4edf7;
	}
	.corner-visual::before {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle, #fff8 0 1px, transparent 1.6px) 18px 26px /
				118px 118px,
			radial-gradient(circle, #db7d746b 0 1px, transparent 1.8px) 72px
				88px / 176px 176px,
			linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
			linear-gradient(
				90deg,
				rgba(255, 255, 255, 0.018) 1px,
				transparent 1px
			);
		background-size:
			118px 118px,
			176px 176px,
			72px 72px,
			72px 72px;
		mask-image: linear-gradient(to bottom, #000 0 72%, transparent 100%);
		content: "";
	}
	.corner-map {
		position: absolute;
		z-index: 1;
		inset: 0;
		pointer-events: none;
	}
	.corner-map svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.corner-map path {
		fill: none;
		stroke-linecap: round;
	}
	.corner-map .route-shadow {
		stroke: #05050a99;
		stroke-width: 18;
	}
	.corner-map .route-line {
		stroke: #db7d74;
		stroke-width: 3;
		stroke-dasharray: 3 13;
		filter: drop-shadow(0 0 8px #db7d7499);
	}
	.corner-map circle {
		fill: #181321;
		stroke: #f0c1b9;
		stroke-width: 3;
		filter: drop-shadow(0 0 10px #db7d74);
	}
	.corner-heading {
		position: absolute;
		z-index: 2;
		top: 13vh;
		left: clamp(2rem, 5vw, 6rem);
	}
	.corner-heading p {
		margin: 0;
		color: #c39bc9;
		font-family: var(--chapter-kicker-font-family);
		font-size: var(--chapter-kicker-font-size);
		font-weight: 600;
		line-height: 1.4;
		letter-spacing: 0.3em;
	}
	.corner-heading h1 {
		margin: 0.45rem 0;
		font-size: clamp(3.2rem, 5vw, 6rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0.1em;
	}
	.corner-heading span {
		color: #b9aebf;
		font-size: 0.84rem;
		letter-spacing: 0.1em;
	}
	.platform {
		position: absolute;
		z-index: 3;
		top: 12vh;
		right: 4.5vw;
		width: 60vw;
	}
	.section-title {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.section-title b {
		color: #bd8fc5;
		font: 600 0.6rem sans-serif;
	}
	.section-title h2 {
		margin: 0;
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0.16em;
	}
	.section-title small {
		color: #807487;
		font: 600 0.52rem sans-serif;
		letter-spacing: 0.22em;
	}
	.signs {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: clamp(0.5rem, 1vw, 1.1rem);
		margin-top: 1.5rem;
	}
	.idol-sign {
		position: relative;
		height: auto;
		min-height: 0;
		aspect-ratio: 1;
		padding: 1.4rem 1rem;
		border: 1px solid color-mix(in srgb, var(--light) 55%, transparent);
		overflow: hidden;
		color: #fff;
		text-decoration: none;
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--light) 24%, #171322),
			color-mix(in srgb, var(--light) 8%, #12101a) 72%,
			#12101acc
		);
		box-shadow:
			inset 0 2px color-mix(in srgb, var(--light) 72%, transparent),
			inset 0 0 25px #0005;
		transform-style: preserve-3d;
		transition:
			border-color 0.3s,
			transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
			box-shadow 0.3s;
	}
	.idol-sign img {
		position: absolute;
		z-index: 1;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
		opacity: 0.48;
		transition:
			opacity 0.3s,
			transform 0.45s;
	}
	.idol-sign small,
	.idol-sign strong,
	.idol-sign span,
	.idol-sign em {
		position: relative;
		z-index: 2;
	}
	.idol-sign small {
		display: block;
		color: color-mix(in srgb, var(--light) 80%, white);
		font: 600 0.55rem sans-serif;
		letter-spacing: 0.2em;
	}
	.idol-sign strong {
		display: block;
		margin-top: 0.7rem;
		font-size: clamp(1.35rem, 2vw, 2rem);
		font-weight: 500;
		letter-spacing: 0.16em;
		text-shadow: 0 2px 10px #080610;
	}
	.idol-sign span {
		color: #d2cad4;
		font-size: 0.6rem;
		letter-spacing: 0.09em;
		text-shadow: 0 1px 8px #080610;
	}
	.idol-sign em {
		position: absolute;
		bottom: 1rem;
		left: 1rem;
		color: #f0dff2;
		font-size: 0.62rem;
		font-style: normal;
		opacity: 0;
		text-shadow: 0 1px 8px #080610;
		translate: 0 5px;
		transition: 0.25s;
	}
	.idol-sign:hover,
	.idol-sign:focus-visible {
		border-color: var(--light);
		transform: translateY(-8px) rotateY(-8deg) rotateX(4deg) scale(1.02);
		box-shadow:
			inset 0 2px var(--light),
			0 16px 40px #0006,
			0 0 28px color-mix(in srgb, var(--light) 48%, transparent);
	}
	.idol-sign:hover img,
	.idol-sign:focus-visible img {
		opacity: 0.7;
		transform: scale(1.04) translateX(2%);
	}
	.idol-sign:hover em,
	.idol-sign:focus-visible em {
		opacity: 1;
		translate: 0;
	}
	.idol-sign:focus-visible,
	.stop:focus-visible {
		outline: 2px solid #f3dff5;
		outline-offset: 4px;
	}
	.stops {
		position: absolute;
		z-index: 4;
		top: 48vh;
		right: 4.5vw;
		left: 4.5vw;
	}
	.stop-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.4rem, 0.65vw, 0.75rem);
		margin-top: 1rem;
	}
	.stop {
		position: relative;
		display: grid;
		grid-template-columns: 24px minmax(0, 1fr);
		min-height: 112px;
		padding: 0.9rem 0.8rem;
		border: 1px solid #b993bd3d;
		overflow: hidden;
		color: #eee5f0;
		text-decoration: none;
		background: linear-gradient(112deg, #211a2bd9, #12131ed9 72%);
		box-shadow:
			inset 3px 0 #a778aa70,
			0 10px 28px #03050a38;
		transform-origin: left center;
		transition:
			border-color 0.25s,
			background 0.25s,
			box-shadow 0.25s,
			transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.stop::before {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 3px;
		background: linear-gradient(180deg, #e1bae5, #a778aa);
		box-shadow: 0 0 12px #bd8fc566;
		content: "";
		opacity: 0.75;
	}
	.stop::after {
		position: absolute;
		right: -18px;
		bottom: -26px;
		width: 72px;
		height: 72px;
		border: 1px solid #cda6d151;
		border-radius: 50%;
		content: "";
		transition: 0.25s;
	}
	.stop > b {
		color: #b78dbf;
		font: 600 0.58rem sans-serif;
	}
	.stop div {
		display: grid;
		min-width: 0;
		align-content: start;
	}
	.stop small {
		overflow: hidden;
		color: #a287a8;
		font: 600 0.48rem sans-serif;
		letter-spacing: 0.14em;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.stop strong {
		margin: 0.25rem 0;
		font-size: clamp(0.76rem, 0.82vw, 0.95rem);
		font-weight: 500;
		letter-spacing: 0.08em;
	}
	.stop span {
		color: #9c919f;
		font-size: 0.58rem;
		line-height: 1.45;
	}
	.stop em {
		grid-column: 2;
		margin-top: 0.35rem;
		color: #d9badf;
		font-size: 0.56rem;
		font-style: normal;
		opacity: 0.62;
		transition: 0.25s;
	}
	.stop:hover,
	.stop:focus-visible {
		border-color: #d7addc8f;
		background: linear-gradient(112deg, #33243ee6, #171723e6 72%);
		box-shadow:
			inset 3px 0 #d29bd8,
			0 13px 30px #03050a66,
			0 0 20px #bd8fc530;
		transform: translateY(-4px) rotate(-1.2deg) translateX(3px);
	}
	.stop:hover::after,
	.stop:focus-visible::after {
		border-color: #e1bae5a3;
		box-shadow: 0 0 24px #bd8fc548;
	}
	.stop:hover em,
	.stop:focus-visible em {
		opacity: 1;
	}
	@media (max-width: 1200px) and (min-width: 761px) {
		.stops {
			right: 4vw;
			left: 4vw;
		}
		.stop-list {
			gap: 0.55rem;
		}
		.stop {
			min-height: 92px;
			padding: 0.65rem 0.75rem;
		}
		.stop em {
			position: absolute;
			right: 0.75rem;
			bottom: 0.55rem;
		}
		.stop strong {
			font-size: 0.88rem;
		}
	}
	@media (max-width: 900px) {
		.corner-heading {
			top: 11vh;
			left: 1.4rem;
		}
		.corner-heading span {
			display: none;
		}
		.platform {
			top: 25vh;
			right: 1.4rem;
			width: calc(100% - 2.8rem);
		}
		.signs {
			gap: 0.35rem;
		}
		.idol-sign {
			height: auto;
			min-height: 0;
			padding: 0.8rem;
		}
		.idol-sign strong {
			font-size: 1.1rem;
		}
		.idol-sign em {
			display: none;
		}
		.stops {
			top: 51vh;
		}
	}
	@media (max-width: 560px) {
		.corner-heading h1 {
			font-size: 2.8rem;
		}
		.section-title small {
			display: none;
		}
		.signs {
			grid-template-columns: repeat(5, 1fr);
		}
		.idol-sign {
			padding: 0.55rem 0.3rem;
		}
		.idol-sign small {
			font-size: 0.42rem;
		}
		.idol-sign strong {
			font-size: 0.88rem;
		}
		.idol-sign span {
			display: none;
		}
		.stop {
			grid-template-columns: 20px 1fr;
			padding: 0.6rem;
		}
		.stop span {
			display: none;
		}
		.stop strong {
			font-size: 0.72rem;
		}
	}
	@media (min-width: 761px) and (max-height: 560px) {
		.corner-visual {
			overflow-x: hidden;
			overflow-y: auto;
			overscroll-behavior: contain;
			padding: 92px 24px 34px;
		}
		.corner-map {
			position: fixed;
			opacity: 0.52;
		}
		.corner-heading,
		.platform,
		.stops {
			position: relative;
			top: auto;
			right: auto;
			bottom: auto;
			left: auto;
			width: auto;
		}
		.corner-heading {
			margin-bottom: 28px;
		}
		.corner-heading h1 {
			font-size: clamp(2.8rem, 7vw, 4.2rem);
		}
		.signs {
			margin-top: 12px;
		}
		.stops {
			margin-top: 32px;
		}
	}
	@media (max-width: 760px) {
		.corner-visual {
			overflow-x: hidden;
			overflow-y: auto;
			overscroll-behavior: contain;
			padding: 92px 16px calc(34px + env(safe-area-inset-bottom, 0px));
			background:
				radial-gradient(circle at 85% 7%, #a779a038, transparent 25%),
				linear-gradient(155deg, #181324, #100e1a 58%, #090a10);
		}
		.corner-visual::before {
			position: fixed;
		}
		.corner-map {
			position: fixed;
			opacity: 0.52;
		}
		.corner-heading,
		.platform,
		.stops {
			position: relative;
			top: auto;
			right: auto;
			bottom: auto;
			left: auto;
			width: auto;
		}
		.corner-heading {
			margin-bottom: 34px;
		}
		.corner-heading p {
			font-size: var(--chapter-kicker-font-size);
		}
		.corner-heading h1 {
			font-size: 2.75rem;
		}
		.corner-heading span {
			display: block;
			font-size: 0.72rem;
			line-height: 1.7;
		}
		.platform {
			margin: 0;
		}
		.signs {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 9px;
			margin-top: 14px;
		}
		.idol-sign {
			height: auto;
			min-height: 0;
			padding: 16px 13px;
		}
		.idol-sign:hover,
		.idol-sign:focus-visible {
			transform: translateY(-4px) scale(1.01);
		}
		.idol-sign:last-child {
			grid-column: 1/-1;
			min-height: 0;
			aspect-ratio: 2/1;
		}
		.idol-sign:last-child img {
			right: 0;
			left: auto;
			width: 50%;
			height: 100%;
		}
		.idol-sign small {
			font-size: 0.5rem;
		}
		.idol-sign strong {
			font-size: 1.35rem;
		}
		.idol-sign span {
			display: block;
			font-size: 0.52rem;
		}
		.idol-sign em {
			display: block;
			opacity: 0.68;
			translate: 0;
		}
		.stops {
			margin-top: 38px;
		}
		.stop-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 9px;
			margin-top: 14px;
		}
		.stop {
			min-height: 116px;
			padding: 13px 11px;
		}
		.stop span {
			display: block;
		}
		.stop strong {
			font-size: 0.86rem;
		}
		.stop em {
			display: block;
			opacity: 0.62;
		}
		.stop:hover,
		.stop:focus-visible {
			transform: translateY(-3px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.idol-sign:hover,
		.idol-sign:focus-visible,
		.stop:hover,
		.stop:focus-visible {
