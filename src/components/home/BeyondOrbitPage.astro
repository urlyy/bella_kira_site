---
const idols = [
  { name:"贝拉", latin:"BELLA", group:"A-SOUL · 舞担", color:"#d985a6", href:"https://space.bilibili.com/672353429" },
  { name:"嘉然", latin:"DIANA", group:"A-SOUL", color:"#e6a16e", href:"https://space.bilibili.com/672328094" },
  { name:"乃琳", latin:"EILEEN", group:"A-SOUL", color:"#ac87d3", href:"https://space.bilibili.com/672342685" },
  { name:"心宜", latin:"FIONA", group:"枝江虚拟偶像", color:"#ed91ad", href:"https://space.bilibili.com/3537115310721181" },
  { name:"思诺", latin:"GLADYS", group:"枝江虚拟偶像", color:"#72add9", href:"https://space.bilibili.com/3537115310721781" },
];
const links = [
  { name:"贝拉五周年", note:"写给第五年的纪念站", href:"https://www.bk0717.com/", code:"BK 0717" },
  { name:"闪耀舞台", note:"心宜与思诺粉丝导航站", href:"https://fionagladys.com/", code:"FIONA / GLADYS" },
  { name:"A-SOUL导航", note:"A-SOUL相关资源导航", href:"https://nav.asoul.us.kg", code:"A-SOUL NAV" },
  { name:"贝极星周报", note:"贝极星周报B站主页", href:"https://space.bilibili.com/2114847153", code:"BELLA STAR WEEKLY" },
  { name:"贝极星空间站的日常", note:"B站话题组", href:"https://www.bilibili.com/v/topic/detail?topic_id=32780&topic_name=贝极星空间站的日常", code:"BILIBILI TOPIC" },
];
---
<section class="page corner-page" data-page-name="corner" aria-label="枝江路标"><div class="page-visual corner-visual mobile-page-scroll-surface">
  <div class="river" aria-hidden="true"><i></i></div><div class="city" aria-hidden="true"></div>
  <header class="corner-heading"><p>ZHIJIANG · LINKS & PLACES</p><h1>枝江路标</h1><span>从这里去往她们的主页，也发现沿途值得停留的地方。</span></header>
  <section class="platform" aria-labelledby="idols-title"><div class="section-title"><b>01</b><h2 id="idols-title">枝江虚拟偶像</h2><small>OFFICIAL PROFILES</small></div>
    <div class="signs">{idols.map((idol,i)=><a class="idol-sign" href={idol.href} target="_blank" rel="noreferrer" style={`--light:${idol.color};--i:${i}`}><small>{idol.latin}</small><strong>{idol.name}</strong><span>{idol.group}</span><em>前往主页 ↗</em></a>)}</div>
  </section>
  <section class="stops" aria-labelledby="stops-title"><div class="section-title"><b>02</b><h2 id="stops-title">站外资源</h2><small>LINKS & RESOURCES</small></div>
    <div class="stop-list">{links.map((link,i)=><a class="stop" href={link.href} target="_blank" rel="noreferrer"><b>{String(i+1).padStart(2,"0")}</b><div><small>{link.code}</small><strong>{link.name}</strong><span>{link.note}</span></div><em>向此处 ↗</em></a>)}</div>
  </section>
</div></section>
<style>
.corner-visual{overflow:hidden;background:linear-gradient(180deg,#171427 0 48%,#262037 48.2%,#0e111c 77%,#080b13);color:#f4edf7}.corner-visual::before{position:absolute;inset:0;background:radial-gradient(circle at 76% 13%,#a779a044,transparent 27%),linear-gradient(110deg,transparent 48%,#ffffff09 48.2%,transparent 48.5%);content:""}.city{position:absolute;right:0;bottom:44%;width:65%;height:24%;opacity:.6;background:linear-gradient(90deg,transparent 1%,#141322 1% 7%,transparent 7% 9%,#171528 9% 14%,transparent 14% 16%,#12121f 16% 25%,transparent 25% 28%,#191526 28% 33%,transparent 33% 35%,#10101d 35% 47%,transparent 47% 50%,#171522 50% 59%,transparent 59% 62%,#12121c 62% 72%,transparent 72% 75%,#151321 75% 89%,transparent 89%);clip-path:polygon(0 100%,0 70%,5% 70%,5% 35%,12% 35%,12% 65%,22% 65%,22% 15%,31% 15%,31% 54%,44% 54%,44% 30%,55% 30%,55% 72%,68% 72%,68% 10%,77% 10%,77% 57%,89% 57%,89% 27%,96% 27%,96% 70%,100% 70%,100% 100%)}.river{position:absolute;right:0;bottom:22%;left:0;height:26%;overflow:hidden;background:linear-gradient(180deg,#211a30,#101421)}.river::before{position:absolute;inset:0;background:repeating-linear-gradient(174deg,transparent 0 17px,#cc9ccf12 18px,#ffffff09 19px,transparent 21px);content:""}.river i{position:absolute;top:0;left:57%;width:120px;height:100%;background:linear-gradient(180deg,#d68ecb45,transparent);filter:blur(13px);transform:skewX(-18deg)}
.corner-heading{position:absolute;z-index:2;top:13vh;left:clamp(2rem,5vw,6rem)}.corner-heading p{margin:0;color:#c39bc9;font:600 .65rem sans-serif;letter-spacing:.3em}.corner-heading h1{margin:.45rem 0;font-size:clamp(3.2rem,5vw,6rem);font-weight:400;line-height:1;letter-spacing:.1em}.corner-heading span{color:#b9aebf;font-size:.84rem;letter-spacing:.1em}.platform{position:absolute;z-index:3;top:12vh;right:4.5vw;width:60vw}.section-title{display:flex;align-items:center;gap:.75rem}.section-title b{color:#bd8fc5;font:600 .6rem sans-serif}.section-title h2{margin:0;font-size:1rem;font-weight:500;letter-spacing:.16em}.section-title small{color:#807487;font:600 .52rem sans-serif;letter-spacing:.22em}.signs{display:grid;grid-template-columns:repeat(5,1fr);gap:clamp(.5rem,1vw,1.1rem);margin-top:1.5rem}.idol-sign{position:relative;height:21vh;min-height:150px;padding:1.4rem 1rem;border:1px solid color-mix(in srgb,var(--light) 38%,transparent);overflow:hidden;color:#fff;text-decoration:none;background:linear-gradient(180deg,color-mix(in srgb,var(--light) 15%,#171322),#12101acc);box-shadow:inset 0 0 25px #0005;transition:.3s}.idol-sign::before{position:absolute;right:-25px;bottom:-35px;width:100px;height:100px;border:1px solid var(--light);border-radius:50%;box-shadow:0 0 35px var(--light);content:"";opacity:.28}.idol-sign small{display:block;color:var(--light);font:600 .55rem sans-serif;letter-spacing:.2em}.idol-sign strong{display:block;margin-top:.7rem;font-size:clamp(1.35rem,2vw,2rem);font-weight:500;letter-spacing:.16em}.idol-sign span{color:#a79daa;font-size:.6rem;letter-spacing:.09em}.idol-sign em{position:absolute;bottom:1rem;left:1rem;color:#dcc7e0;font-size:.62rem;font-style:normal;opacity:0;translate:0 5px;transition:.25s}.idol-sign:hover,.idol-sign:focus-visible{border-color:var(--light);transform:translateY(-6px);box-shadow:0 12px 35px #0005,0 0 22px color-mix(in srgb,var(--light) 25%,transparent)}.idol-sign:hover em,.idol-sign:focus-visible em{opacity:1;translate:0}.idol-sign:focus-visible,.stop:focus-visible{outline:2px solid #f3dff5;outline-offset:4px}
.stops{position:absolute;z-index:4;right:4.5vw;bottom:5vh;width:54vw}.stop-list{display:grid;grid-template-columns:repeat(3,1fr);margin-top:1rem;border-top:1px solid #b993bd48;border-bottom:1px solid #b993bd30}.stop{display:grid;grid-template-columns:28px 1fr;min-height:108px;padding:1rem;border-right:1px solid #b993bd30;border-bottom:1px solid #b993bd30;color:#eee5f0;text-decoration:none;transition:.25s}.stop:nth-child(3n){border-right:0}.stop:nth-last-child(-n+2){border-bottom:0}.stop>b{color:#966fa0;font:600 .58rem sans-serif}.stop div{display:grid;align-content:start}.stop small{color:#947c9a;font:600 .5rem sans-serif;letter-spacing:.18em}.stop strong{margin:.25rem 0;font-size:.95rem;font-weight:500;letter-spacing:.11em}.stop span{color:#8e8492;font-size:.6rem}.stop em{grid-column:2;margin-top:.5rem;color:#d6b5db;font-size:.58rem;font-style:normal;opacity:0}.stop:hover{background:#b98ab413;transform:translateY(-3px)}.stop:hover em{opacity:1}
@media(max-width:900px){.corner-heading{top:11vh;left:1.4rem}.corner-heading span{display:none}.platform{top:25vh;right:1.4rem;width:calc(100% - 2.8rem)}.signs{gap:.35rem}.idol-sign{height:17vh;min-height:120px;padding:.8rem}.idol-sign strong{font-size:1.1rem}.idol-sign em{display:none}.stops{right:1.4rem;bottom:5vh;width:calc(100% - 2.8rem)}.river{bottom:23%;height:30%}}
@media(max-width:560px){.corner-heading h1{font-size:2.8rem}.section-title small{display:none}.signs{grid-template-columns:repeat(5,1fr)}.idol-sign{padding:.55rem .3rem}.idol-sign small{font-size:.42rem}.idol-sign strong{font-size:.88rem}.idol-sign span{display:none}.stop{grid-template-columns:20px 1fr;padding:.6rem}.stop span{display:none}.stop strong{font-size:.72rem}}
@media(max-width:760px){
  .corner-visual{overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;padding:92px 16px calc(34px + env(safe-area-inset-bottom,0px));background:radial-gradient(circle at 85% 7%,#a779a038,transparent 25%),linear-gradient(180deg,#171427,#12101d 58%,#090b13)}
  .corner-visual::before{position:fixed}.city{position:fixed;right:-30%;bottom:38%;width:110%;height:22%;opacity:.25}.river{position:fixed;bottom:0;height:30%;opacity:.34}
  .corner-heading,.platform,.stops{position:relative;top:auto;right:auto;bottom:auto;left:auto;width:auto}
  .corner-heading{margin-bottom:34px}.corner-heading p{font-size:.52rem}.corner-heading h1{font-size:2.75rem}.corner-heading span{display:block;font-size:.72rem;line-height:1.7}
  .platform{margin:0}.signs{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:14px}.idol-sign{height:auto;min-height:138px;padding:16px 13px}.idol-sign:last-child{grid-column:1/-1;min-height:112px}.idol-sign small{font-size:.5rem}.idol-sign strong{font-size:1.35rem}.idol-sign span{display:block;font-size:.52rem}.idol-sign em{display:block;opacity:.68;translate:0}
  .stops{margin-top:38px}.stop-list{grid-template-columns:1fr;margin-top:14px}.stop{min-height:94px;border-right:0;border-bottom:1px solid #b993bd30;padding:14px}.stop:nth-child(3n){border-right:0}.stop:nth-last-child(-n+2){border-bottom:1px solid #b993bd30}.stop:last-child{border-bottom:0}.stop span{display:block}.stop strong{font-size:.9rem}.stop em{display:block;opacity:.62}
}
</style>
