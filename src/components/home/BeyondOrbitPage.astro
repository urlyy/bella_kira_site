---
<section class="page corner-page" data-page-name="corner" aria-label="枝江路标"><div class="page-visual corner-visual mobile-page-scroll-surface">
  <div class="river" aria-hidden="true"><i></i></div><div class="city" aria-hidden="true"></div>
  <header class="corner-heading"><p>ZHIJIANG · LINKS & PLACES</p><h1>枝江路标</h1></header>
  <section class="platform" aria-labelledby="idols-title"><div class="section-title"><b>01</b><h2 id="idols-title">枝江虚拟偶像</h2><small>OFFICIAL PROFILES</small></div>
    <div class="signs">{idols.map((idol,i)=><a class="idol-sign" href={idol.href} target="_blank" rel="noreferrer" style={`--light:${idol.color};--i:${i}`}><img data-src={idol.avatar} alt="" width="480" height="480" loading="lazy" draggable="false" decoding="async"/><small>{idol.latin}</small><strong>{idol.name}</strong><span>{idol.group}</span><em>前往主页 ↗</em></a>)}</div>
  </section>
  <section class="stops" aria-labelledby="stops-title"><div class="section-title"><b>02</b><h2 id="stops-title">站外资源</h2><small>LINKS & RESOURCES</small></div>
    <div class="stop-list">{links.map((link,i)=><a class="stop" href={link.href} target="_blank" rel="noreferrer"><b>{String(i+1).padStart(2,"0")}</b><div><small>{link.code}</small><strong>{link.name}</strong><span>{link.note}</span></div><em>向此处 ↗</em></a>)}</div>
  </section>
</div></section>
<script>
  const initializeCornerImages = () => {
    document.querySelectorAll<HTMLImageElement>(".corner-page img[data-src]").forEach((image) => {
      if (image.dataset.src) image.src = image.dataset.src;
      delete image.dataset.src;
    });
  };
  window.addEventListener("bella:pagewillchange", (event) => {
    if ((event as CustomEvent<{ toHash?: string }>).detail?.toHash === "#corner") initializeCornerImages();
  });
  if (window.location.hash === "#corner") initializeCornerImages();
</script>
<style>
.corner-visual{overflow:hidden;background:linear-gradient(180deg,#171427 0 48%,#262037 48.2%,#0e111c 77%,#080b13);color:#f4edf7}.corner-visual::before{position:absolute;inset:0;background:radial-gradient(circle at 76% 13%,#a779a044,transparent 27%),linear-gradient(110deg,transparent 48%,#ffffff09 48.2%,transparent 48.5%);content:""}.city{position:absolute;right:0;bottom:44%;width:65%;height:24%;opacity:.6;background:linear-gradient(90deg,transparent 1%,#141322 1% 7%,transparent 7% 9%,#171528 9% 14%,transparent 14% 16%,#12121f 16% 25%,transparent 25% 28%,#191526 28% 33%,transparent 33% 35%,#10101d 35% 47%,transparent 47% 50%,#171522 50% 59%,transparent 59% 62%,#12121c 62% 72%,transparent 72% 75%,#151321 75% 89%,transparent 89%);clip-path:polygon(0 100%,0 70%,5% 70%,5% 35%,12% 35%,12% 65%,22% 65%,22% 15%,31% 15%,31% 54%,44% 54%,44% 30%,55% 30%,55% 72%,68% 72%,68% 10%,77% 10%,77% 57%,89% 57%,89% 27%,96% 27%,96% 70%,100% 70%,100% 100%)}.river{position:absolute;right:0;bottom:22%;left:0;height:26%;overflow:hidden;background:linear-gradient(180deg,#211a30,#101421)}.river::before{position:absolute;inset:0;background:repeating-linear-gradient(174deg,transparent 0 17px,#cc9ccf12 18px,#ffffff09 19px,transparent 21px);content:""}.river i{position:absolute;top:0;left:57%;width:120px;height:100%;background:linear-gradient(180deg,#d68ecb45,transparent);filter:blur(13px);transform:skewX(-18deg)}
.corner-heading{position:absolute;z-index:2;top:13vh;left:clamp(2rem,5vw,6rem)}.corner-heading p{margin:0;color:#c39bc9;font:600 .65rem sans-serif;letter-spacing:.3em}.corner-heading h1{margin:.45rem 0;font-size:clamp(3.2rem,5vw,6rem);font-weight:400;line-height:1;letter-spacing:.1em}.corner-heading span{color:#b9aebf;font-size:.84rem;letter-spacing:.1em}.platform{position:absolute;z-index:3;top:12vh;right:4.5vw;width:60vw}.section-title{display:flex;align-items:center;gap:.75rem}.section-title b{color:#bd8fc5;font:600 .6rem sans-serif}.section-title h2{margin:0;font-size:1rem;font-weight:500;letter-spacing:.16em}.section-title small{color:#807487;font:600 .52rem sans-serif;letter-spacing:.22em}.signs{display:grid;grid-template-columns:repeat(5,1fr);gap:clamp(.5rem,1vw,1.1rem);margin-top:1.5rem}.idol-sign{position:relative;height:auto;min-height:0;aspect-ratio:1;padding:1.4rem 1rem;border:1px solid color-mix(in srgb,var(--light) 55%,transparent);overflow:hidden;color:#fff;text-decoration:none;background:linear-gradient(180deg,color-mix(in srgb,var(--light) 24%,#171322),color-mix(in srgb,var(--light) 8%,#12101a) 72%,#12101acc);box-shadow:inset 0 2px color-mix(in srgb,var(--light) 72%,transparent),inset 0 0 25px #0005;transition:.3s}.idol-sign img{position:absolute;z-index:1;inset:0;width:100%;height:100%;object-fit:contain;object-position:center;opacity:.48;transition:opacity .3s,transform .45s}.idol-sign small,.idol-sign strong,.idol-sign span,.idol-sign em{position:relative;z-index:2}.idol-sign small{display:block;color:color-mix(in srgb,var(--light) 80%,white);font:600 .55rem sans-serif;letter-spacing:.2em}.idol-sign strong{display:block;margin-top:.7rem;font-size:clamp(1.35rem,2vw,2rem);font-weight:500;letter-spacing:.16em;text-shadow:0 2px 10px #080610}.idol-sign span{color:#d2cad4;font-size:.6rem;letter-spacing:.09em;text-shadow:0 1px 8px #080610}.idol-sign em{position:absolute;bottom:1rem;left:1rem;color:#f0dff2;font-size:.62rem;font-style:normal;opacity:0;text-shadow:0 1px 8px #080610;translate:0 5px;transition:.25s}.idol-sign:hover,.idol-sign:focus-visible{border-color:var(--light);transform:translateY(-6px);box-shadow:inset 0 2px var(--light),0 12px 35px #0005,0 0 22px color-mix(in srgb,var(--light) 35%,transparent)}.idol-sign:hover img,.idol-sign:focus-visible img{opacity:.64;transform:scale(1.025)}.idol-sign:hover em,.idol-sign:focus-visible em{opacity:1;translate:0}.idol-sign:focus-visible,.stop:focus-visible{outline:2px solid #f3dff5;outline-offset:4px}
.stops{position:absolute;z-index:4;top:calc(12vh + 12vw + 4rem);right:4.5vw;left:4.5vw}.stop-list{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:clamp(.4rem,.65vw,.75rem);margin-top:1rem}.stop{position:relative;display:grid;grid-template-columns:24px minmax(0,1fr);min-height:106px;padding:.9rem .8rem;border:1px solid #b993bd3d;overflow:hidden;color:#eee5f0;text-decoration:none;background:linear-gradient(112deg,#211a2bd9,#12131ed9 72%);box-shadow:inset 3px 0 #a778aa70,0 10px 28px #03050a38;transition:border-color .25s,background .25s,box-shadow .25s,transform .25s}.stop::after{position:absolute;right:-18px;bottom:-26px;width:72px;height:72px;border:1px solid #cda6d151;border-radius:50%;content:"";transition:.25s}.stop>b{color:#b78dbf;font:600 .58rem sans-serif}.stop div{display:grid;min-width:0;align-content:start}.stop small{overflow:hidden;color:#a287a8;font:600 .48rem sans-serif;letter-spacing:.14em;text-overflow:ellipsis;white-space:nowrap}.stop strong{margin:.25rem 0;font-size:clamp(.76rem,.82vw,.95rem);font-weight:500;letter-spacing:.08em}.stop span{color:#9c919f;font-size:.58rem;line-height:1.45}.stop em{grid-column:2;margin-top:.35rem;color:#d9badf;font-size:.56rem;font-style:normal;opacity:.62;transition:.25s}.stop:hover,.stop:focus-visible{border-color:#d7addc8f;background:linear-gradient(112deg,#33243ee6,#171723e6 72%);box-shadow:inset 3px 0 #d29bd8,0 13px 30px #03050a66;transform:translateY(-4px)}.stop:hover::after,.stop:focus-visible::after{border-color:#e1bae5a3;box-shadow:0 0 24px #bd8fc548}.stop:hover em,.stop:focus-visible em{opacity:1}
@media(max-width:1200px) and (min-width:761px){.stops{right:4vw;left:4vw}.stop-list{grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem}.stop{min-height:82px;padding:.65rem .75rem}.stop em{position:absolute;right:.75rem;bottom:.55rem}.stop strong{font-size:.88rem}}
@media(max-width:900px){.corner-heading{top:11vh;left:1.4rem}.corner-heading span{display:none}.platform{top:25vh;right:1.4rem;width:calc(100% - 2.8rem)}.signs{gap:.35rem}.idol-sign{height:auto;min-height:0;padding:.8rem}.idol-sign strong{font-size:1.1rem}.idol-sign em{display:none}.stops{top:calc(25vh + 20vw + 4rem)}.river{bottom:23%;height:30%}}
@media(max-width:560px){.corner-heading h1{font-size:2.8rem}.section-title small{display:none}.signs{grid-template-columns:repeat(5,1fr)}.idol-sign{padding:.55rem .3rem}.idol-sign small{font-size:.42rem}.idol-sign strong{font-size:.88rem}.idol-sign span{display:none}.stop{grid-template-columns:20px 1fr;padding:.6rem}.stop span{display:none}.stop strong{font-size:.72rem}}
@media(max-width:760px){
  .corner-visual{overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;padding:92px 16px calc(34px + env(safe-area-inset-bottom,0px));background:radial-gradient(circle at 85% 7%,#a779a038,transparent 25%),linear-gradient(180deg,#171427,#12101d 58%,#090b13)}
  .corner-visual::before{position:fixed}.city{position:fixed;right:-30%;bottom:38%;width:110%;height:22%;opacity:.25}.river{position:fixed;bottom:0;height:30%;opacity:.34}
  .corner-heading,.platform,.stops{position:relative;top:auto;right:auto;bottom:auto;left:auto;width:auto}
  .corner-heading{margin-bottom:34px}.corner-heading p{font-size:.52rem}.corner-heading h1{font-size:2.75rem}.corner-heading span{display:block;font-size:.72rem;line-height:1.7}
  .platform{margin:0}.signs{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:14px}.idol-sign{height:auto;min-height:0;padding:16px 13px}.idol-sign:last-child{grid-column:1/-1;min-height:0;aspect-ratio:2/1}.idol-sign:last-child img{right:0;left:auto;width:50%;height:100%}.idol-sign small{font-size:.5rem}.idol-sign strong{font-size:1.35rem}.idol-sign span{display:block;font-size:.52rem}.idol-sign em{display:block;opacity:.68;translate:0}
  .stops{margin-top:38px}.stop-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:14px}.stop{min-height:116px;padding:13px 11px}.stop span{display:block}.stop strong{font-size:.86rem}.stop em{display:block;opacity:.62}
}
</style>
