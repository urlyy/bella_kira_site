<div class="games-head-model" data-head-model aria-label="跟随指针轻轻转动的团子模型">
	<canvas aria-hidden="true"></canvas>
	<span class="games-head-model-loading" aria-hidden="true"></span>
</div>

<script>
	import * as THREE from "three";
	import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
	import { MeshoptDecoder } from "three/examples/jsm/libs/meshopt_decoder.module.js";

	const modelUrl = "/assets/3dmodel/tuanzi-web.glb?v=006306677e87852c";
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	document.querySelectorAll<HTMLElement>("[data-head-model]").forEach((root) => {
		if (root.dataset.initialized === "true") return;
		root.dataset.initialized = "true";

		const canvas = root.querySelector<HTMLCanvasElement>("canvas");
		if (!canvas) return;

		let renderer: THREE.WebGLRenderer | undefined;
		let camera: THREE.PerspectiveCamera | undefined;
		let scene: THREE.Scene | undefined;
		let pivot: THREE.Group | undefined;
		let frame = 0;
		let loaded = false;
		let active = !root.closest(".page");
		let targetPitch = 0;
		let targetYaw = 0;

		const render = () => {
			if (!renderer || !camera || !scene) return;
			renderer.render(scene, camera);
		};

		const animate = () => {
			frame = 0;
			if (!active || document.hidden || !pivot || reducedMotion.matches) return;
			pivot.rotation.x += (targetPitch - pivot.rotation.x) * 0.075;
			pivot.rotation.y += (targetYaw - pivot.rotation.y) * 0.075;
			render();
			frame = window.requestAnimationFrame(animate);
		};

		const syncAnimation = () => {
			if (!loaded || !active || document.hidden || reducedMotion.matches) {
				if (frame) window.cancelAnimationFrame(frame);
				frame = 0;
				render();
				return;
			}
			if (!frame) frame = window.requestAnimationFrame(animate);
		};

		const resize = () => {
			if (!renderer || !camera) return;
			const width = Math.max(1, root.clientWidth);
			const height = Math.max(1, root.clientHeight);
			renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
			renderer.setSize(width, height, false);
			camera.aspect = width / height;
			camera.updateProjectionMatrix();
			render();
		};

		const load = () => {
			if (renderer) {
				active = true;
				syncAnimation();
				return;
			}

			try {
				renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: "high-performance" });
			} catch {
				root.classList.add("is-unavailable");
				return;
			}

			renderer.outputColorSpace = THREE.SRGBColorSpace;
			renderer.toneMapping = THREE.ACESFilmicToneMapping;
			renderer.toneMappingExposure = 0.82;
			scene = new THREE.Scene();
			camera = new THREE.PerspectiveCamera(28, 1, 0.01, 20);
			camera.position.set(0, 0, 2);

			scene.add(new THREE.HemisphereLight(0xfff3f7, 0x251537, 0.85));
			const keyLight = new THREE.DirectionalLight(0xffeadf, 1.45);
			keyLight.position.set(2.4, 3, 4);
			scene.add(keyLight);
			const rimLight = new THREE.DirectionalLight(0xb794ff, 0.72);
			rimLight.position.set(-3, 1.5, -2);
			scene.add(rimLight);

			resize();
			const loader = new GLTFLoader();
			loader.setMeshoptDecoder(MeshoptDecoder);
			loader.load(
				modelUrl,
				(gltf) => {
					if (!scene || !camera) return;
					const box = new THREE.Box3().setFromObject(gltf.scene);
					const center = box.getCenter(new THREE.Vector3());
					const size = box.getSize(new THREE.Vector3());
					gltf.scene.position.sub(center);

					pivot = new THREE.Group();
					pivot.add(gltf.scene);
					scene.add(pivot);

					const verticalDistance = size.y / (2 * Math.tan(THREE.MathUtils.degToRad(camera.fov / 2)));
					camera.position.set(0, size.y * 0.015, verticalDistance * 1.13 + size.z * 0.5);
					camera.lookAt(0, 0, 0);
					loaded = true;
					root.classList.add("is-loaded");
					resize();
					syncAnimation();
				},
				undefined,
				() => root.classList.add("is-unavailable"),
			);
		};

		const updateActiveState = (isActive: boolean) => {
			active = isActive;
			if (active) load();
			syncAnimation();
		};

		window.addEventListener("pointermove", (event) => {
			if (!active || !pivot || reducedMotion.matches || event.pointerType === "touch") return;
			const bounds = root.getBoundingClientRect();
			const x = THREE.MathUtils.clamp((event.clientX - bounds.left) / bounds.width * 2 - 1, -1.4, 1.4);
			const y = THREE.MathUtils.clamp((event.clientY - bounds.top) / bounds.height * 2 - 1, -1.4, 1.4);
			targetYaw = x * 0.22;
			targetPitch = y * 0.12;
		}, { passive: true });

		window.addEventListener("bella:pagechange", ((event: CustomEvent<{ hash: string }>) => {
			updateActiveState(event.detail.hash === "#space");
		}) as EventListener);
		document.addEventListener("visibilitychange", syncAnimation);
		reducedMotion.addEventListener("change", syncAnimation);
		new ResizeObserver(resize).observe(root);

		if (!root.closest(".page") || window.location.hash === "#space") {
			updateActiveState(true);
		}
	});
</script>
