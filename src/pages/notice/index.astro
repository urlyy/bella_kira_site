---
import CursorStars from "../../components/home/CursorStars.astro";
import SiteHeader from "../../components/home/SiteHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const notices = [
  {
    number: "01",
    label: "IMAGE · AUDIO · VIDEO",
    title: "图片与影音",
    copy: "本站为非官方、非商业性质的粉丝应援项目，与官方运营方不存在隶属关系。角色形象、官方图片、标识、音乐、视频及其他官方素材的相关权利归原权利方所有；站内注明来源的同人作品，其权利仍归各自创作者所有。",
  },
  {
    number: "02",
    label: "MMD · MODEL ASSETS",
    title: "模型与三维素材",
    copy: "站内展示的 MMD 及其他模型资产遵循原作者随附的许可、README 与使用规则。除非获得明确许可，本站不提供模型文件下载、提取、转换或再分发，也不因展示而取得模型资产的所有权或额外授权。",
  },
  {
    number: "03",
    label: "FAN FICTION",
    title: "同人文字",
    copy: "同人文著作权归原作者所有。转载或展示内容保留其原始来源及授权背景；相关权利人可要求补充来源、修正信息或移除内容。站内展示不代表作品与官方存在关联。",
  },
];

const updates = [
  {
    date: "2026.07.11",
    title: "站点公告与资源导航调整",
    items: [
      "新增独立的站点公告页面，并加入主导航。",
      "原“枝江一隅”更名为“枝江路标”，明确用于前往虚拟偶像主页与相关站外资源。",
      "站点公告与首页滚轮页面序列隔离，仅通过导航栏进入。",
    ],
  },
];
---

<SiteLayout title="站点公告 · 贝拉Kira" description="贝拉Kira粉丝站的免责声明与版权说明">
  <main class="notice-page">
    <SiteHeader />
    <div class="notice-atmosphere" aria-hidden="true">
      <span class="station-light station-light-left"></span>
      <span class="station-light station-light-right"></span>
      <span class="rail rail-one"></span>
      <span class="rail rail-two"></span>
    </div>

    <article class="notice-board" aria-labelledby="notice-title">
      <header class="notice-heading">
        <div>
          <p>SITE NOTICE · BELLA KIRA</p>
          <h1 id="notice-title">站点公告</h1>
          <span>更新记录 / 版权与使用说明</span>
        </div>
        <p class="notice-intro">这里集中公开站点的近期变化、素材使用边界与权利人请求。更新与版权各自成章，方便查阅，也方便长期维护。</p>
      </header>

      <section class="notice-section updates-section" aria-labelledby="updates-title">
        <header class="notice-section-heading">
          <span>01</span>
          <div><small>SITE UPDATES</small><h2 id="updates-title">更新说明</h2></div>
          <p>记录站点页面、内容和交互的公开变化。</p>
        </header>
        <details class="updates-panel">
          <summary>
            <span><small>LATEST UPDATE</small><strong>{updates[0].title}</strong></span>
            <span class="updates-meta">{updates[0].date} · 共 {String(updates.length).padStart(2, "0")} 条</span>
            <i aria-hidden="true"></i>
          </summary>
          <div class="updates-scroll">
            <ol class="updates-list">
              {updates.map((update) => (
                <li>
                  <time datetime={update.date.replaceAll(".", "-")}>{update.date}</time>
                  <div>
                    <h3>{update.title}</h3>
                    <ul>{update.items.map((item) => <li>{item}</li>)}</ul>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </details>
      </section>

      <section class="notice-section rights-section" aria-labelledby="rights-title">
        <header class="notice-section-heading">
          <span>02</span>
          <div><small>RIGHTS & USAGE</small><h2 id="rights-title">版权与使用说明</h2></div>
          <p>说明站内素材的权利归属、使用边界与处理方式。</p>
        </header>

        <div class="notice-list">
          {notices.map((notice) => (
            <section class="notice-item">
              <div class="notice-index"><b>{notice.number}</b><span>{notice.label}</span></div>
              <h3>{notice.title}</h3>
              <p>{notice.copy}</p>
            </section>
          ))}
        </div>

        <footer class="notice-footer">
          <div><span>RIGHTS HOLDER REQUESTS</span><strong>权利人请求</strong></div>
          <p>如需补充署名、修正来源或移除相关内容，请联系站点维护者处理。收到可核实的信息后，我们会认真核对并及时响应。</p>
        </footer>

        <aside class="feedback-card" aria-labelledby="feedback-title">
          <div>
            <span>SUGGESTIONS & FEEDBACK</span>
            <h3 id="feedback-title">建议与反馈</h3>
          </div>
          <p>网站仍在持续建设与改进中。如果你对内容、功能或浏览体验有任何建议，或发现需要修正的问题，都欢迎通过 Bilibili 私信告诉我。请联系用户 <a target="_blank" rel="noopener noreferrer" href="https://space.bilibili.com/36733462">UID 36733462</a>，每一条认真提出的意见都会被看到。</p>
        </aside>
      </section>
    </article>
  </main>
  <CursorStars />
</SiteLayout>

<style>
  :global(html:has(.notice-page)),
  :global(body:has(.notice-page)) { overflow: auto; background: #0c0d16; }
  .notice-page { position: relative; min-height: 100svh; overflow: hidden; color: #eee9f1; background: linear-gradient(180deg, #171524 0 43%, #10131e 43% 100%); }
  .notice-page :global(.site-header) { color: #f7eef7; }
  .notice-page :global(.brand), .notice-page :global(.nav-link) { color: #d4b3da; text-shadow: 0 1px 0 #251828, 0 0 10px rgba(220, 177, 222, .32), 0 2px 12px rgba(0, 0, 0, .72); }
  .notice-page :global(.brand strong span), .notice-page :global(.nav-link.is-active), .notice-page :global(.nav-link:hover) { color: #efb1ad; }
  .notice-page :global(.main-nav::before) { background: linear-gradient(90deg, transparent, rgba(221, 182, 219, .34) 14%, rgba(221, 182, 219, .34) 86%, transparent); }
  .notice-page :global(.nav-link::before) { border-top-color: rgba(239, 177, 173, .72); }
  .notice-page :global(.nav-link::after) { background: radial-gradient(ellipse, rgba(239, 177, 173, .16), rgba(197, 143, 195, .08) 42%, transparent 72%); }
  .notice-page :global(.nav-link-label::before), .notice-page :global(.nav-link-label::after) { background: linear-gradient(90deg, transparent, rgba(239, 177, 173, .9)); }
  .notice-page :global(.nav-link-label::after) { background: linear-gradient(90deg, rgba(239, 177, 173, .9), transparent); }
  .notice-page :global(.nav-link-ornament) { color: #efb1ad; }
  .notice-atmosphere { position: fixed; inset: 0; pointer-events: none; }
  .notice-atmosphere::before { position: absolute; inset: 0; background: radial-gradient(circle at 68% 8%, rgba(193, 130, 185, .18), transparent 28%), repeating-linear-gradient(90deg, transparent 0 12.45vw, rgba(255,255,255,.018) 12.5vw); content: ""; }
  .notice-atmosphere::after { position: absolute; right: 0; bottom: 0; left: 0; height: 31vh; background: linear-gradient(180deg, rgba(33, 29, 45, .62), #080b13), repeating-linear-gradient(174deg, transparent 0 21px, rgba(204,156,207,.06) 22px, transparent 24px); content: ""; }
  .station-light { position: absolute; top: 0; width: 1px; height: 35vh; background: linear-gradient(#d9acd3, transparent); opacity: .22; transform-origin: top; }
  .station-light::after { position: absolute; top: 0; left: 0; width: 18vw; height: 42vh; background: linear-gradient(90deg, rgba(228,194,225,.14), transparent); clip-path: polygon(0 0, 100% 100%, 0 83%); content: ""; }
  .station-light-left { left: 12%; rotate: -4deg; }.station-light-right { right: 13%; rotate: 5deg; scale: -1 1; }
  .rail { position: absolute; z-index: 1; right: -5vw; bottom: 6vh; width: 68vw; height: 1px; background: linear-gradient(90deg, transparent, rgba(219,125,116,.42), transparent); rotate: -5deg; }.rail-two { bottom: 3vh; opacity: .5; }
  .notice-board { position: relative; z-index: 2; width: min(1180px, calc(100% - 64px)); margin: 0 auto; padding: 150px 0 70px; }
  .notice-heading { display: grid; grid-template-columns: minmax(300px, .72fr) minmax(320px, 1fr); align-items: end; gap: 48px; padding-bottom: 34px; border-bottom: 1px solid rgba(214,179,215,.24); }
  .notice-heading div:first-child>p { margin: 0 0 11px; color: #bc92bf; font: 600 10px/1 system-ui, sans-serif; letter-spacing: .3em; }
  .notice-heading h1 { margin: 0; font-size: clamp(48px, 6vw, 82px); font-weight: 400; line-height: .95; letter-spacing: .12em; }
  .notice-heading div:first-child>span { display: block; margin-top: 15px; color: #b5a9b8; font-size: 13px; letter-spacing: .18em; }
  .notice-intro { max-width: 570px; margin: 0 0 2px auto; color: #a9a0ad; font-size: 14px; line-height: 2; letter-spacing: .05em; }
  .notice-section { padding-top: 42px; }
  .notice-section-heading { display: grid; grid-template-columns: 48px minmax(240px,.75fr) minmax(280px,1fr); align-items: end; gap: 26px; margin-bottom: 18px; }
  .notice-section-heading>span { color: #db7d74; font: 600 11px/1 system-ui,sans-serif; letter-spacing: .12em; }
  .notice-section-heading>div { display: flex; align-items: baseline; gap: 15px; }
  .notice-section-heading small { color: #8d748f; font: 600 8px/1 system-ui,sans-serif; letter-spacing: .2em; }
  .notice-section-heading h2 { margin: 0; color: #e7dce9; font-size: 20px; font-weight: 400; letter-spacing: .14em; }
  .notice-section-heading>p { max-width: 520px; margin: 0 0 1px auto; color: #8f8793; font-size: 12px; line-height: 1.7; }
  .updates-panel { border: 1px solid rgba(214,179,215,.2); background: rgba(8,9,17,.32); }
  .updates-panel summary { display: grid; grid-template-columns: minmax(0,1fr) auto 24px; min-height: 78px; align-items: center; gap: 22px; padding: 0 28px; color: #ded2e1; cursor: pointer; list-style: none; transition: background .2s ease; }
  .updates-panel summary::-webkit-details-marker { display: none; }
  .updates-panel summary:hover, .updates-panel summary:focus-visible { background: rgba(194,139,190,.07); }
  .updates-panel summary:focus-visible { outline: 2px solid #e7c9e7; outline-offset: -2px; }
  .updates-panel summary>span:first-child { display: flex; min-width: 0; align-items: baseline; gap: 16px; }
  .updates-panel summary small { color: #9a7d9e; font: 600 8px/1 system-ui,sans-serif; letter-spacing: .22em; }
  .updates-panel summary strong { overflow: hidden; font-size: 15px; font-weight: 400; letter-spacing: .1em; text-overflow: ellipsis; white-space: nowrap; }
  .updates-meta { color: #8f8391; font-size: 11px; letter-spacing: .1em; }
  .updates-panel summary i { position: relative; width: 18px; height: 18px; border: 1px solid rgba(219,125,116,.38); border-radius: 50%; transition: rotate .2s ease, border-color .2s ease; }
  .updates-panel summary i::before, .updates-panel summary i::after { position: absolute; top: 50%; left: 50%; width: 7px; height: 1px; background: #d89b9b; content: ""; translate: -50% -50%; }
  .updates-panel summary i::after { rotate: 90deg; transition: opacity .2s ease; }
  .updates-panel[open] summary i { border-color: #db7d74; rotate: 180deg; }
  .updates-panel[open] summary i::after { opacity: 0; }
  .updates-scroll { max-height: min(290px, 36svh); overflow-y: auto; overscroll-behavior: contain; scrollbar-color: rgba(219,125,116,.52) rgba(255,255,255,.04); scrollbar-width: thin; border-top: 1px solid rgba(214,179,215,.12); }
  .updates-list { margin: 0; padding: 0 28px; list-style: none; }
  .updates-list>li { display: grid; grid-template-columns: 120px minmax(0,1fr); gap: 32px; padding: 28px 0 30px; border-bottom: 1px solid rgba(214,179,215,.1); }
  .updates-list>li:last-child { border-bottom: 0; }
  .updates-list time { color: #db918b; font: 600 10px/1.5 system-ui,sans-serif; letter-spacing: .14em; }
  .updates-list h3 { margin: 0 0 13px; color: #e5dae7; font-size: 16px; font-weight: 400; letter-spacing: .1em; }
  .updates-list ul { display: grid; gap: 7px; margin: 0; padding: 0; color: #9f96a2; font-size: 12px; line-height: 1.7; list-style: none; }
  .updates-list ul li { position: relative; padding-left: 15px; }
  .updates-list ul li::before { position: absolute; top: .72em; left: 0; width: 5px; height: 1px; background: #9d779e; content: ""; }
  .rights-section { padding-top: 50px; }
  .notice-list { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(214,179,215,.2); border-bottom: 1px solid rgba(214,179,215,.2); }
  .notice-item { position: relative; min-height: 300px; padding: 34px clamp(22px, 2.6vw, 38px) 38px; border-right: 1px solid rgba(214,179,215,.16); background: linear-gradient(180deg, rgba(255,255,255,.025), transparent); }
  .notice-item:last-child { border-right: 0; }
  .notice-index { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: #866f8c; font: 600 9px/1 system-ui, sans-serif; letter-spacing: .14em; }
  .notice-index b { color: #db7d74; font-size: 11px; }.notice-index span { text-align: right; }
  .notice-item h3 { margin: 52px 0 19px; color: #e7dce9; font-size: 22px; font-weight: 400; letter-spacing: .15em; }
  .notice-item p { margin: 0; color: #a9a0ad; font-size: 13px; line-height: 1.9; text-align: justify; }
  .notice-footer { display: grid; grid-template-columns: 190px minmax(0,1fr) auto; align-items: center; gap: 34px; padding: 28px 4px; }
  .notice-footer div { display: grid; gap: 6px; }.notice-footer div span { color: #8d748f; font: 600 8px/1 system-ui, sans-serif; letter-spacing: .19em; }.notice-footer div strong { font-size: 15px; font-weight: 400; letter-spacing: .13em; }
  .notice-footer>p { margin: 0; color: #8f8793; font-size: 12px; line-height: 1.8; }
  .notice-footer a { padding: 11px 16px; border: 1px solid rgba(219,125,116,.35); color: #ddaaa8; font-size: 12px; letter-spacing: .1em; text-decoration: none; transition: background .2s, border-color .2s, color .2s; }
  .notice-footer a:hover, .notice-footer a:focus-visible { border-color: #db7d74; color: #fff; background: rgba(219,125,116,.12); }.notice-footer a:focus-visible { outline: 2px solid #e7c9e7; outline-offset: 3px; }
  .feedback-card { display: grid; grid-template-columns: 190px minmax(0, 1fr); align-items: start; gap: 34px; margin-top: 8px; padding: 26px 28px; border: 1px solid rgba(214,179,215,.18); background: linear-gradient(100deg, rgba(190,132,185,.08), rgba(219,125,116,.045)); }
  .feedback-card div { display: grid; gap: 7px; }.feedback-card span { color: #8d748f; font: 600 8px/1 system-ui,sans-serif; letter-spacing: .19em; }.feedback-card h3 { margin: 0; color: #e7dce9; font-size: 15px; font-weight: 400; letter-spacing: .13em; }
  .feedback-card p { margin: 0; color: #a9a0ad; font-size: 12px; line-height: 1.9; }
  .feedback-card a { color: #e1aaa7; text-decoration-color: rgba(219,125,116,.5); text-underline-offset: .25em; transition: color .2s, text-decoration-color .2s; }.feedback-card a:hover, .feedback-card a:focus-visible { color: #fff; text-decoration-color: #db7d74; }.feedback-card a:focus-visible { outline: 2px solid #e7c9e7; outline-offset: 3px; }
  @media(max-width: 900px) { .notice-board { width: min(100% - 40px, 720px); padding-top: 142px; }.notice-heading { grid-template-columns: 1fr; gap: 18px; }.notice-intro { margin: 0; }.notice-section-heading { grid-template-columns: 38px 1fr; }.notice-section-heading>p { grid-column: 2; margin: 0; }.notice-list { grid-template-columns: 1fr; }.notice-item { min-height: 0; border-right: 0; border-bottom: 1px solid rgba(214,179,215,.16); }.notice-item h3 { margin-top: 28px; }.notice-footer { grid-template-columns: 1fr auto; }.notice-footer>p { grid-column: 1 / -1; grid-row: 2; } }
  @media(max-width: 560px) { .notice-board { width: calc(100% - 32px); padding-top: 132px; }.notice-intro { font-size: 12px; }.notice-heading h1 { font-size: 46px; }.notice-section { padding-top: 34px; }.notice-section-heading { grid-template-columns: 28px 1fr; gap: 12px; }.notice-section-heading>div { display: grid; gap: 7px; }.notice-section-heading>p { grid-column: 2; }.updates-panel summary { grid-template-columns: minmax(0,1fr) 20px; gap: 12px; padding: 0 12px; }.updates-panel summary>span:first-child { display: grid; gap: 7px; }.updates-meta { display: none; }.updates-list { padding: 0 12px; }.updates-list>li { grid-template-columns: 1fr; gap: 12px; padding-block: 24px; }.rights-section { padding-top: 42px; }.notice-item { padding: 28px 8px 30px; }.notice-footer { grid-template-columns: 1fr; gap: 18px; padding-bottom: 28px; }.notice-footer>p { grid-column: 1; grid-row: auto; }.feedback-card { grid-template-columns: 1fr; gap: 16px; padding: 22px 18px; } }
  @media(prefers-reduced-motion: reduce) { .notice-footer a, .updates-panel summary, .updates-panel summary i, .updates-panel summary i::after { transition: none; } }
</style>
