---
import {
	superChatMessages,
	superChatTiers,
} from "../../../content/superchat-catch";
import shellUrl from "../_shared/game-shell.css?url";
import styleUrl from "./_assets/style.css?url";
import gameUrl from "./_assets/game.js?url";

const gameData = JSON.stringify({
	tiers: superChatTiers,
	messages: superChatMessages,
}).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta name="theme-color" content="#10091f" />
		<meta
			name="description"
			content="左右移动贝拉，接住从直播间落下的醒目留言，在羞耻值爆表前积累财富。"
		/>
		<title>接住 SC · 贝拉kira小游戏</title>
		<link rel="stylesheet" href={styleUrl} />
		<link rel="stylesheet" href={shellUrl} />
	</head>
	<body>
		<main class="page">
			<header class="game-heading">
				<div>
					<p class="kicker">BELLA KIRA · SUPER CHAT CATCH</p>
					<h1>接住 SC</h1>
					<p class="intro">
						接得越多，财富越多；有些话，却不是那么容易接住的。
					</p>
				</div>
				<button
					class="sound-button"
					id="sound-toggle"
					type="button"
					aria-label="关闭音效"
					aria-pressed="true"
				>
					<span aria-hidden="true">♫</span>
				</button>
			</header>

			<section class="game-card" aria-label="接住 SC 游戏">
				<div class="hud">
					<div class="hud-item wealth-item">
						<span>财富值</span>
						<strong><small>¥</small><b id="wealth">0</b></strong>
					</div>
					<div class="shame-item">
						<div class="shame-label">
							<span>羞耻值</span><strong id="shame-label"
								>0%</strong
							>
						</div>
						<div
							class="shame-track"
							role="progressbar"
							aria-label="羞耻值"
							aria-valuemin="0"
							aria-valuemax="100"
							aria-valuenow="0"
							id="shame-track"
						>
							<i id="shame-fill"></i>
						</div>
						<small>自然增长 +1.0 / 秒</small>
					</div>
					<div class="hud-item catch-item">
						<span>已接住</span><strong
							><b id="caught">0</b><small> 条</small></strong
						>
					</div>
					<div class="hud-item best-item">
						<span>最佳财富</span><strong
							><small>¥</small><b id="best">0</b></strong
						>
					</div>
				</div>

				<div class="stage" id="stage">
					<div class="broadcast-bar" aria-hidden="true">
						<span><i></i> LIVE</span>
						<b>贝拉kira的直播间</b>
						<em>醒目留言投递中</em>
					</div>
					<div class="stage-stars" aria-hidden="true"></div>
					<div class="drop-layer" id="drop-layer"></div>

					<div class="reaction" id="reaction" aria-live="polite">
						<small>贝拉</small>
						<p id="reaction-text">先让我看看今天都有什么留言……</p>
					</div>

					<!-- 临时 CSS 角色；后续序列帧可以直接替换这个容器的视觉层。 -->
					<div
						class="bella-player"
						id="bella-player"
						aria-hidden="true"
					>
						<div class="bella-shadow"></div>
						<div class="bella-sprite">
							<i class="hair-back"></i>
							<i class="hair-bun hair-bun-left"></i>
							<i class="hair-bun hair-bun-right"></i>
							<span class="face"><i></i><i></i><b></b></span>
							<i class="fringe"></i>
							<span class="body"><i>✦</i></span>
							<i class="arm arm-left"></i><i class="arm arm-right"
							></i>
							<span class="catch-glow">接</span>
						</div>
					</div>

					<div class="floor-light" aria-hidden="true"></div>

					<div class="overlay" id="overlay">
						<div class="overlay-card">
							<p class="kicker" id="overlay-kicker">
								HOW TO PLAY
							</p>
							<h2 id="overlay-title">在脸红之前，多接一点！</h2>
							<p id="overlay-text">
								左右移动贝拉接住
								SC，金额会直接变成财富值。每条预设留言都会增加对应的羞耻值；羞耻值也会持续缓慢上涨，满格时本局结束。
							</p>
							<div class="control-hints" id="control-hints">
								<span
									><kbd>←</kbd><kbd>→</kbd> 或 <kbd>A</kbd
									><kbd>D</kbd></span
								>
								<span>触屏可拖动角色或使用下方按钮</span>
							</div>
							<button id="start-button" type="button"
								>开始接 SC</button
							>
						</div>
					</div>
				</div>

				<div class="mobile-controls" aria-label="移动控制">
					<button
						type="button"
						data-direction="left"
						aria-label="向左移动"
					>
						<span aria-hidden="true">←</span> 向左
					</button>
					<p>
						<span id="last-price">等待</span><small
							id="last-message">第一条 SC</small
						>
					</p>
					<button
						type="button"
						data-direction="right"
						aria-label="向右移动"
					>
						向右 <span aria-hidden="true">→</span>
					</button>
				</div>
			</section>
		</main>

		<div
			class="game-toast"
			id="game-toast"
			role="status"
			aria-live="polite"
		>
			<img src="/assets/贝极星.png" alt="" draggable="false" />
			<span id="toast-message"></span>
		</div>

		<a class="site-return" href="/games/" aria-label="返回互动空间"
			>← 互动空间</a
		>
		<script
			is:inline
			id="superchat-data"
			type="application/json"
			set:html={gameData}
		/>
		<script is:inline src={gameUrl}></script>
	</body>
</html>
