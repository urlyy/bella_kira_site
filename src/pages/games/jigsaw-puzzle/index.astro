---
import shellUrl from "../_shared/game-shell.css?url";
import styleUrl from "./_assets/style.css?url";
import splitterUrl from "./_assets/jigsaw-splitter.js?url";
import gameUrl from "./_assets/game.js?url";
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a081b">
  <title>星光碎片 · 贝拉不规则拼图</title>
  <link rel="stylesheet" href={styleUrl}>
  <link rel="stylesheet" href={shellUrl}>
</head>
<body>
  <main class="app">
    <header>
      <div><p class="kicker">BELLA KIRA · JIGSAW</p><h1>星光碎片</h1><p>把散落的舞台光影，轻轻放回它原来的位置。</p></div>
      <button id="preview" class="ghost" type="button" aria-pressed="false">查看原图</button>
    </header>
    <section class="game-shell">
      <aside class="panel">
        <div class="stats"><div><span>已归位</span><strong id="placed">0 / 9</strong></div><div><span>时间</span><strong id="time">00:00</strong></div></div>
        <div class="controls">
          <label for="imageSelect">选择图片</label><select id="imageSelect"></select>
          <label class="upload" for="imageUpload">＋ 上传自己的图片</label><input id="imageUpload" type="file" accept="image/png,image/jpeg,image/webp,image/gif" hidden>
          <label for="difficulty">拼图难度</label><select id="difficulty"><option value="3">轻松 · 3 × 3</option><option value="4">挑战 · 4 × 4</option><option value="5">进阶 · 5 × 5</option></select>
          <button id="recut" type="button">换一种切法</button>
          <button id="shuffle" class="secondary" type="button">只重新打乱</button>
        </div>
        <p class="tip"><i></i>拖动碎片，靠近正确位置会自动吸附</p>
      </aside>
      <div class="play-area" id="playArea">
        <div class="board" id="board"><img id="guideImage" alt="拼图位置提示" draggable="false"></div>
        <div class="tray" id="tray" aria-label="待拼碎片区"></div>
        <div class="original" id="original" hidden><img id="originalImage" alt="拼图完整原图" draggable="false"><span>ORIGINAL</span></div>
      </div>
    </section>
  </main>
  <div class="modal" id="winModal" hidden><div class="modal-card" role="dialog" aria-modal="true"><span>✦</span><p class="kicker">LIGHT RESTORED</p><h2>星光重新完整</h2><p id="summary"></p><button id="again" type="button">再换一种切法</button></div></div>
  <a class="site-return" href="/games/" aria-label="返回互动空间">← 互动空间</a>
  <script is:inline src={splitterUrl}></script><script is:inline src={gameUrl}></script>
</body>
</html>
