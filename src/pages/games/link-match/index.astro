---
import shellUrl from "../_shared/game-shell.css?url";
import styleUrl from "./_assets/style.css?url";
import gameUrl from "./_assets/game.js?url";
import stickerData from "../../../content/stickers.json";

const officialStickers = stickerData.officialGroups.flatMap((group) =>
	group.items.map((src, index) => ({
		src,
		name: `${group.name} ${index + 1}`,
	})),
);
---

<!doctype html>
<html lang="zh-CN">
	<head
		><meta charset="UTF-8" /><meta
			name="viewport"
			content="width=device-width,initial-scale=1"
		/><title>图案连连看 · 贝拉连连看</title><link
			rel="stylesheet"
			href={styleUrl}
		/><link rel="stylesheet" href={shellUrl} /></head
	><body
		><main>
			<header>
				<div>
					<p>BELLA KIRA · LINK MATCH</p><h1>图案连连看</h1><span
						>找出两个相同图案，用不超过两次转弯的路线将它们连接。</span
					>
				</div><button id="restart">重新开局</button>
			</header><section>
				<aside>
					<div>
						<small>剩余</small><strong id="left">48</strong>
					</div><div>
						<small>时间</small><strong id="time">03:00</strong>
					</div><button id="hint">提示</button><button id="shuffle"
						>洗牌</button
					><p>
						相同图案之间的连线不能穿过其他方块，最多允许两个转角。
					</p>
				</aside><div class="board-wrap">
					<div
						id="board"
						data-items={JSON.stringify(officialStickers)}
					>
					</div><svg id="path"></svg><div id="modal" hidden>
						<h2 id="result">完成</h2><p id="summary"></p><button
							id="again">再玩一次</button
						>
					</div>
				</div>
			</section>
		</main><a class="site-return" href="/games/" aria-label="返回互动空间"
			>← 互动空间</a
		><script is:inline src={gameUrl}></script></body
	>
</html>
