---
import shellUrl from "../_shared/game-shell.css?url";
import styleUrl from "./_assets/style.css?url";
import gameUrl from "./_assets/game.js?url";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#100b28" />
		<title>应援接接乐 · 贝拉限时反应游戏</title>
		<link rel="stylesheet" href={styleUrl} />
		<link rel="stylesheet" href={shellUrl} />
	</head>
	<body>
		<main class="app">
			<header>
				<div>
					<p class="kicker">BELLA KIRA · STAR HIT</p>
					<h1>应援接接乐</h1>
					<p class="intro">接住舞台应援物，避开突然冒出的土豆雷。</p>
				</div>
				<button
					id="sound"
					class="round"
					type="button"
					aria-pressed="true"
					aria-label="关闭音效">♫</button
				>
			</header>

			<section class="game" aria-label="应援接接乐游戏">
				<div class="hud">
					<div>
						<span>剩余</span><strong id="time">30.0</strong><small
							>秒</small
						>
					</div>
					<div><span>得分</span><strong id="score">0</strong></div>
					<div><span>连击</span><strong id="combo">×0</strong></div>
					<div><span>最高</span><strong id="best">0</strong></div>
				</div>

				<div class="stage" id="stage">
					<div class="stage-light"></div>
					<div class="grid" id="grid" aria-label="目标区域"></div>
					<div class="curtain curtain-left"></div>
					<div class="curtain curtain-right"></div>

					<div class="overlay" id="overlay">
						<p class="kicker">30 SECOND CHALLENGE</p>
						<h2 id="overlayTitle">准备接住星光了吗？</h2>
						<p id="overlayText">
							星星 +10 · 话筒 +15 · 羊驼 +20<br />土豆雷
							−25，并会打断连击
						</p>
						<button id="start" type="button">开始挑战</button>
					</div>
				</div>

				<footer>
					<p><i class="safe"></i> 点击应援目标得分</p>
					<p><i class="danger"></i> 不要点击土豆雷</p>
				</footer>
			</section>
		</main>
		<a class="site-return" href="/games/" aria-label="返回互动空间"
			>← 互动空间</a
		>
		<script is:inline src={gameUrl}></script>
	</body>
</html>
