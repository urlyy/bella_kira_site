---
import shellUrl from "../_shared/game-shell.css?url";
import styleUrl from "./_assets/style.css?url";
import gameUrl from "./_assets/game.js?url";
---

<!doctype html>
<html lang="zh-CN">
	<head
		><meta charset="UTF-8" /><meta
			name="viewport"
			content="width=device-width,initial-scale=1"
		/><title>应援物合成 · 贝拉合成游戏</title><link
			rel="stylesheet"
			href={styleUrl}
		/><link rel="stylesheet" href={shellUrl} /></head
	><body
		><main>
			<header>
				<div>
					<p>BELLA KIRA · MERGE</p><h1>应援物合成</h1><span
						>把相同的应援物碰在一起，合成更闪耀的星光。</span
					>
				</div><button id="restart">重新开始</button>
			</header><section>
				<aside>
					<div>
						<small>分数</small><strong id="score">0</strong>
					</div><div>
						<small>最高</small><strong id="best">0</strong>
					</div><p>
						移动指针选择落点，点击投下。相同等级相碰会继续合成。
					</p><ol id="levels"></ol>
				</aside><div class="game">
					<canvas id="canvas" width="420" height="620"></canvas><div
						id="over"
						hidden
					>
						<h2>星光堆满啦</h2><p id="summary"></p><button
							id="again">再来一次</button
						>
					</div>
				</div>
			</section>
		</main><a class="site-return" href="/games/" aria-label="返回互动空间"
			>← 互动空间</a
		><script is:inline src={gameUrl}></script></body
	>
</html>
