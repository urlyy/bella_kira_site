---
import "../styles/global.css";
import "../styles/themes.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "贝拉kira粉丝站",
  description = "贝拉kira粉丝站是非官方、非商业的粉丝应援站点",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d090c" />
    <script is:inline>
      (() => {
        const storageKey = "bella-kira-theme";
        const root = document.documentElement;
        const colors = { dark: "#0d090c", light: "#f5f2f7" };
        const getStoredTheme = () => {
          try {
            const value = window.localStorage.getItem(storageKey);
            return value === "dark" || value === "light" ? value : null;
          } catch {
            return null;
          }
        };
        const applyTheme = (theme, persist = false) => {
          const nextTheme = theme === "light" ? "light" : "dark";
          root.dataset.theme = nextTheme;
          root.style.colorScheme = nextTheme;
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", colors[nextTheme]);
          if (persist) {
            try {
              window.localStorage.setItem(storageKey, nextTheme);
            } catch {}
          }
          document.dispatchEvent(new CustomEvent("bella:themechange", { detail: { theme: nextTheme } }));
          return nextTheme;
        };
        const storedTheme = getStoredTheme();
        window.__bellaTheme = { apply: applyTheme, getStored: getStoredTheme };
        applyTheme(storedTheme ?? "dark");
      })();
    </script>
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" type="image/png" href="/assets/favicon/favicon-32.png?v=2" sizes="32x32" />
    <link rel="icon" type="image/png" href="/assets/favicon/favicon-16.png?v=2" sizes="16x16" />
    <link rel="apple-touch-icon" href="/assets/favicon/apple-touch-icon.png?v=2" sizes="180x180" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      document.addEventListener("dragstart", (event) => {
        if (event.target instanceof HTMLImageElement) event.preventDefault();
      });
    </script>
  </body>
</html>
